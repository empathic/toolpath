---
source: crates/path-cli/tests/cli_surface.rs
expression: "format!(\"{}\\n{}\",\ntranscript(\"the page's \\\"See what happened in this repo\\\"\",\n&[\"p\", \"import\", \"git\", \"--repo\", \".\", \"--branch\", \"main\", \"--no-cache\",\n\"--pretty\"], &one, Some(home.path())),\ntranscript(\"the page's \\\"Multi-branch import\\\"\",\n&[\"p\", \"import\", \"git\", \"--repo\", \".\", \"--branch\", \"main\", \"--branch\",\n\"feature/auth\", \"--no-cache\", \"--pretty\"], &two, Some(home.path())))"
---
$ path p import git --repo . --branch main --no-cache --pretty
exit: 0
--- stdout
