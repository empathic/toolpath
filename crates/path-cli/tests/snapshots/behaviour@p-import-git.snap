      },
      "path": {
        "base": {
          "branch": "main",
          "ref": "130666e755fa91cef750aacd40d3aa5a50d05247",
          "uri": "file://<home>/repo"
        },
        "head": "step-465f8f60",
        "id": "path-main"
      },
      "steps": [
        {
          "change": {
            "a.txt": {
              "raw": "@@ -1 +1,2 @@\n one\n+two\n"
