              "revision": "465f8f6019a1f4687c203e6fc27a4373a7210dcf",
              "type": "git"
            }
          },
          "step": {
            "actor": "human:alex",
            "id": "step-465f8f60",
            "timestamp": "<timestamp>"
          }
        }
      ]
    }
  ]
}
