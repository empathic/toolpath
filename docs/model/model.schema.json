{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toolpath.net/schema/toolpath-model-v1.json",
  "title": "toolpath-model/v1",
  "description": "The goldens work as one generated object model. Every object has an id of the form <type>:<key> and links to others by id. Generated by crates/toolpath-model; see docs/model/README.md.",
  "type": "object",
  "required": ["format", "sources", "harnesses", "operations", "sets", "snapshots", "findings", "claims", "pieces", "concerns", "feedback"],
  "properties": {
    "format": { "const": "toolpath-model/v1" },
    "sources": {
      "type": "object",
      "description": "The revision of each repository the model was read from.",
      "additionalProperties": { "type": "object", "required": ["rev"], "properties": { "rev": { "type": "string", "pattern": "^[0-9a-f]{40}$" } } }
    },
    "harnesses": { "type": "array", "items": { "$ref": "#/$defs/harness" } },
    "operations": { "type": "array", "items": { "$ref": "#/$defs/operation" } },
    "sets": { "type": "array", "items": { "$ref": "#/$defs/set" } },
    "snapshots": { "type": "array", "items": { "$ref": "#/$defs/snapshot" } },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "pieces": { "type": "array", "items": { "$ref": "#/$defs/piece" } },
    "concerns": { "type": "array", "items": { "$ref": "#/$defs/concern" } },
    "feedback": { "type": "array", "items": { "$ref": "#/$defs/feedback" } }
  },
  "$defs": {
    "source": {
      "type": "object",
      "description": "Where an object was read: repository, revision, path, and line where there is one.",
      "required": ["repo", "rev", "path"],
      "properties": {
        "repo": { "enum": ["toolpath", "pathbase"] },
        "rev": { "type": "string" },
        "path": { "type": "string" },
        "line": { "type": "integer" },
        "record": { "type": "string" }
      }
    },
    "harness": {
      "type": "object",
      "required": ["id", "name", "versions_seen"],
      "properties": { "id": { "type": "string", "pattern": "^harness:" }, "name": { "type": "string" }, "versions_seen": { "type": "array", "items": { "type": "string" } } }
    },
    "operation": {
      "type": "object",
      "required": ["id", "name", "says", "evidence_kinds"],
      "properties": { "id": { "enum": ["operation:parse", "operation:project", "operation:resume", "operation:share"] }, "name": { "type": "string" }, "says": { "type": "string" }, "evidence_kinds": { "type": "array", "items": { "type": "string" } } }
    },
    "set": {
      "type": "object",
      "required": ["id", "harness", "source"],
      "properties": { "id": { "type": "string", "pattern": "^set:" }, "harness": { "type": "string", "pattern": "^harness:" }, "source": { "$ref": "#/$defs/source" } }
    },
    "snapshot": {
      "type": "object",
      "required": ["id", "kind", "set", "operation", "source"],
      "properties": {
        "id": { "type": "string", "pattern": "^snapshot:(toolpath|pathbase)/" },
        "kind": { "enum": ["ir", "document", "validate", "projection", "round_trip", "shed", "known_defects", "opencode_db", "stored", "stats", "ir_back", "losses", "writer", "formats", "validate_transforms"] },
        "set": { "type": "string", "pattern": "^set:" },
        "target": { "type": "string", "pattern": "^harness:" },
        "operation": { "type": "string", "pattern": "^operation:" },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "finding": {
      "type": "object",
      "required": ["id", "kind", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^finding:" },
        "kind": { "enum": ["loss", "gain", "invented_value", "rename", "change", "known_defect", "declared_unpinned"] },
        "operation": { "type": "string", "pattern": "^operation:" },
        "key_path": { "type": "string" },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "pieces": { "type": "array", "items": { "type": "string", "pattern": "^piece:" } },
        "concerns": { "type": "array", "items": { "type": "string", "pattern": "^concern:" } }
      }
    },
    "claim": {
      "type": "object",
      "required": ["id", "text", "status", "record", "snapshot_status", "evidence", "findings_against", "source"],
      "properties": {
        "id": { "type": "string", "pattern": "^claim:" },
        "text": { "type": "string" },
        "status": { "enum": ["pinned", "partly", "false", "no_record", "quote_not_found"], "description": "From the claim's qualifier record (tag claim:<id>): pass -> pinned, concern -> partly, blocker or fail -> false." },
        "record": { "type": ["string", "null"] },
        "snapshot_status": { "enum": ["pinned", "partly", "unbacked", "quote_not_found"] },
        "evidence_kinds": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "findings_against": { "type": "array", "items": { "type": "string" } },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "piece": {
      "type": "object",
      "required": ["id", "repo", "number", "title", "status", "commits", "source"],
      "properties": {
        "id": { "type": "string", "pattern": "^piece:(toolpath|pathbase)/" },
        "status": { "type": "string" },
        "commits": { "type": "array", "items": { "type": "object", "required": ["cited", "commit", "on_wip"], "properties": { "on_wip": { "type": "boolean" } } } },
        "github": { "type": "object", "required": ["number", "url", "changeling"] },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "concern": {
      "type": "object",
      "required": ["id", "kind", "status", "source"],
      "properties": { "id": { "type": "string", "pattern": "^concern:" }, "status": { "type": "string" }, "source": { "$ref": "#/$defs/source" } }
    },
    "feedback": {
      "type": "object",
      "required": ["id", "url", "comments", "about", "resolved_by"],
      "properties": {
        "id": { "type": "string", "pattern": "^feedback:" },
        "comments": { "type": "array", "items": { "type": "object", "required": ["author", "text"] } },
        "about": { "type": "array", "items": { "type": "string" } },
        "resolved_by": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
