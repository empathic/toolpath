                "schema": {
                  "$ref": "#/components/schemas/AnonUploadResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid document / unsupported variant / empty path"
          },
          "413": {
            "description": "Request body exceeds 5 MB"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
