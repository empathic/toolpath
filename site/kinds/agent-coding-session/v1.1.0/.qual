{"metabox":"1","type":"annotation","subject":"site/kinds/agent-coding-session/v1.1.0/index.md","issuer":"mailto:1240090+bdelanghe@users.noreply.github.com","issuer_type":"ai","created_at":"2026-10-19T20:25:18.495486Z","id":"ac9f3a41119e3a615495d9979f3c4905c530eb6ddb4b6956a0d4297e6d18c2d2","body":{"detail":"document@copilot.snap has meta.source \"copilot\" under this kind URI; the list (and any consumer that trusts it) leaves Copilot out. The schema does not enumerate meta.source, so validate@copilot stays valid. Add copilot to the list.","kind":"blocker","ref":"git:86c325b","span":{"start":{"line":150},"end":{"line":150},"content_hash":"dfdd5582f20dbb38493b6b85da68897c06cd610d7b2b850edb5f0834017654d2"},"summary":"v1.1.0: meta.source is one of six harness names — false: copilot documents carry \"copilot\"","tags":["claim:kind-v110-meta-source","claims","session:claude-code:729d6bb8-59f0-4ddf-892e-603372433260"]}}
