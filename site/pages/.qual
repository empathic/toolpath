{"metabox":"1","type":"annotation","subject":"site/pages/faq.md","issuer":"mailto:1240090+bdelanghe@users.noreply.github.com","issuer_type":"ai","created_at":"2026-10-19T20:31:49.699084Z","id":"c53bd3c7072565c948d6bd1fe253e70eab7deea45ac5ab4723de418d1ab85b7f","body":{"detail":"Agents: provider crates; humans: git/github; formatters/linters: only path p track (cmd_track tool:formatter test).","kind":"concern","ref":"git:04afa53","span":{"start":{"line":26},"end":{"line":26},"content_hash":"30528d23fe11632c90d143ce8839f21e0def401c98441bdecf8051f15bbcbded"},"summary":"FAQ use case: provenance across humans, agents, formatters, linters — agents and git yes, formatters and linters by hand only","tags":["claim:faq-use-multi-actor","claims","session:claude-code:729d6bb8-59f0-4ddf-892e-603372433260"]}}
