@@ -0,0 +1,517 @@
+//! Tests of `pack_batches` (empathic/toolpath#305, Ben Barber's streamed upload) over the
+//! documents the baseline holds. `pack_batches` is pure: no server, no network. Nothing in
+//! #305's code is changed by this module; it is mounted from `cmd_pathbase.rs` by one
+//! `#[cfg(test)] #[path = ...] mod` line.
+//!
+//! What it pins:
+//! 1. reassembly: the batches concatenate back to exactly the writer's output, for every
+//!    document;
+//! 2. each batch is valid on its own, in the shape the server's routes expect;
+//! 3. the edges: an oversize step alone, a small document in one request, a path with no steps;
+//! 4. a property test with a fixed seed: random step sizes, parents and budgets;
+//! 5. an input over 4 MiB built from a real document so the batching path really runs.
+//!
+//! Where the recordings come from: `examples/*.path.json` always; and, when the baseline is in
+//! the tree, every `crates/toolpath-goldens/snapshots/document@*.snap` (13 recordings, including
+//! the four forced compactions). A tree without the baseline tests only the examples.
+
+use super::*;
+use std::path::{Path as FsPath, PathBuf};
+use toolpath::v1::{Graph, Path, PathOrRef};
+
+fn repo() -> PathBuf {
+    FsPath::new(env!("CARGO_MANIFEST_DIR")).join("../..")
+}
+
+/// `(name, path)` for every path (not `$ref`) of every document available.
+fn documents() -> Vec<(String, Path)> {
+    let mut out = Vec::new();
+    let mut add = |name: String, json: &str| {
+        let graph = Graph::from_json(json).unwrap_or_else(|e| panic!("{name}: {e}"));
+        for (i, p) in graph.paths.into_iter().enumerate() {
+            if let PathOrRef::Path(p) = p {
+                out.push((format!("{name}#{i}"), *p));
+            }
+        }
+    };
+    let examples = repo().join("examples");
+    for entry in std::fs::read_dir(&examples).expect("examples") {
+        let p = entry.unwrap().path();
+        let name = p.file_name().unwrap().to_string_lossy().into_owned();
+        if name.ends_with(".path.json") || name.starts_with("graph-") {
+            add(name, &std::fs::read_to_string(&p).unwrap());
+        }
+    }
+    let snaps = repo().join("crates/toolpath-goldens/snapshots");
+    if let Ok(rd) = std::fs::read_dir(&snaps) {
+        for entry in rd.flatten() {
+            let name = entry.file_name().to_string_lossy().into_owned();
+            if name.starts_with("document@") && name.ends_with(".snap") {
+                let text = std::fs::read_to_string(entry.path()).unwrap();
+                let body = text.splitn(3, "---\n").nth(2).expect("snapshot body");
+                add(name, body);
+            }
+        }
+    }
+    out
+}
+
+/// What `stream_paths` does before packing: parents first, then the writer's JSONL.
+fn jsonl_and_ids(path: &Path) -> (String, Vec<String>) {
+    let reordered;
+    let path = match parents_first_order(&path.steps) {
+        Some(order) => {
+            reordered = Path {
+                path: path.path.clone(),
+                steps: order.iter().map(|&i| path.steps[i].clone()).collect(),
+                meta: path.meta.clone(),
+            };
+            &reordered
+        }
+        None => path,
+    };
+    let ids = path.steps.iter().map(|s| s.step.id.clone()).collect();
+    (path.to_jsonl_string().unwrap(), ids)
+}
+
+fn pack(jsonl: &str, ids: &[String], budget: usize) -> Vec<Batch> {
+    let ids: Vec<&str> = ids.iter().map(String::as_str).collect();
+    pack_batches(jsonl, &ids, budget)
+}
+
+fn kind(line: &str) -> String {
+    let v: serde_json::Value = serde_json::from_str(line).unwrap_or_else(|e| panic!("{line}: {e}"));
+    v.as_object()
+        .and_then(|o| o.keys().next().cloned())
+        .expect("a JSONL line is an object with one key")
+}
+
+/// The lines a path ends with after its last step: path-level signatures, `Head`, `PathClose`.
+fn is_closing_tail(kinds: &[String]) -> bool {
+    !kinds.is_empty()
+        && kinds
+            .iter()
+            .all(|k| k == "Signature" || k == "Head" || k == "PathClose")
+}
+
+/// FINDING for #305 (not fixed here, Ben's code is untouched): `pack_batches` closes a batch
+/// when the NEXT line would put it over budget and it already holds a step. When that next line
+/// is one of the closing lines (`Head`, `PathClose`, a path-level `Signature`), the batch before
+/// it is full, so the closing lines become a batch of their own with NO step, sent to the steps
+/// route as a request whose body is `{"Head":..}\n{"PathClose":..}\n`. The doc comment says "a
+/// batch is only closed once it contains a step", which is true of the batch being closed, not
+/// of the one that follows. Whether the server accepts a step-less append is not known here.
+/// The two tests above allow exactly this tail and nothing else; this one is the strict form
+/// and fails today.
+#[test]
+#[ignore = "finding in #305: the closing lines can become a batch with no step (see the doc comment)"]
+fn no_batch_is_ever_without_a_step() {
+    for (name, path) in documents() {
+        if path.steps.is_empty() {
+            continue;
+        }
+        let (jsonl, ids) = jsonl_and_ids(&path);
+        for budget in BUDGETS {
+            for (bi, b) in pack(&jsonl, &ids, budget).iter().enumerate() {
+                assert!(
+                    b.body.lines().any(|l| kind(l) == "Step"),
+                    "{name}@{budget}: batch {bi} has no step"
+                );
+            }
+        }
+    }
+}
+
+/// The budgets the checks run under: tiny (every step alone), mid, and the real one.
+const BUDGETS: [usize; 4] = [1, 700, 20_000, BATCH_BUDGET];
+
+#[test]
+fn there_are_documents_to_test() {
+    let docs = documents();
+    assert!(docs.len() >= 4, "found {} paths", docs.len());
+    if repo().join("crates/toolpath-goldens/snapshots").exists() {
+        assert!(
+            docs.len() >= 17,
+            "the baseline is in the tree: {} paths",
+            docs.len()
+        );
+    }
+}
+
+#[test]
+fn the_batches_concatenate_to_the_writer_output_for_every_document() {
+    for (name, path) in documents() {
+        let (jsonl, ids) = jsonl_and_ids(&path);
+        for budget in BUDGETS {
+            let all: String = pack(&jsonl, &ids, budget)
+                .iter()
+                .map(|b| b.body.as_str())
+                .collect();
+            assert_eq!(all, jsonl, "{name} at budget {budget}");
+        }
+    }
+}
+
+#[test]
+fn every_batch_is_valid_on_its_own() {
+    for (name, path) in documents() {
+        if path.steps.is_empty() {
+            continue;
+        }
+        let (jsonl, ids) = jsonl_and_ids(&path);
+        for budget in BUDGETS {
+            let batches = pack(&jsonl, &ids, budget);
+            let mut seen: std::collections::HashSet<String> = Default::default();
+            let step_parents: std::collections::HashMap<String, Vec<String>> = path
+                .steps
+                .iter()
+                .map(|s| (s.step.id.clone(), s.step.parents.clone()))
+                .collect();
+            for (bi, b) in batches.iter().enumerate() {
+                assert!(b.body.ends_with('\n'), "{name}@{budget} batch {bi}");
+                let lines: Vec<&str> = b.body.lines().collect();
+                let kinds: Vec<String> = lines.iter().map(|l| kind(l)).collect();
+                // the first batch opens the path, and only the first
+                assert_eq!(
+                    kinds.first().map(String::as_str) == Some("PathOpen"),
+                    bi == 0,
+                    "{name}@{budget}: PathOpen belongs to batch 0 only (batch {bi} starts {:?})",
+                    kinds.first()
+                );
+                // a batch with no step: allowed only as the closing tail (see FINDING below)
+                assert!(
+                    kinds.iter().any(|k| k == "Step")
+                        || (bi + 1 == batches.len() && is_closing_tail(&kinds)),
+                    "{name}@{budget}: batch {bi} of {} has no step ({kinds:?})",
+                    batches.len()
+                );
+                // actors are declared in the first batch, before its first step
+                if bi == 0 {
+                    let first_step = kinds.iter().position(|k| k == "Step").unwrap();
+                    assert!(
+                        kinds[..first_step]
+                            .iter()
+                            .all(|k| k == "PathOpen" || k == "ActorDef")
+                    );
+                }
+                // parents come before children, across batches
+                for l in &lines {
+                    if kind(l) == "Step" {
+                        let v: serde_json::Value = serde_json::from_str(l).unwrap();
+                        let id = v["Step"]["step"]["id"].as_str().unwrap().to_string();
+                        for p in &step_parents[&id] {
+                            if step_parents.contains_key(p) {
+                                assert!(
+                                    seen.contains(p),
+                                    "{name}@{budget}: {id} before its parent {p}"
+                                );
+                            }
+                        }
+                        seen.insert(id);
+                    }
+                }
+            }
+        }
+    }
+}
+
+#[test]
+fn a_steps_signatures_stay_in_its_batch() {
+    for (name, path) in documents() {
+        let (jsonl, ids) = jsonl_and_ids(&path);
+        let lines: Vec<&str> = jsonl.lines().collect();
+        for budget in BUDGETS {
+            let batches = pack(&jsonl, &ids, budget);
+            for b in &batches {
+                let kinds: Vec<String> = b.body.lines().map(kind).collect();
+                for (i, l) in b.body.lines().enumerate() {
+                    if l.starts_with(r#"{"Signature":{"target":"step:"#) {
+                        assert!(
+                            kinds[..i].iter().any(|k| k == "Step"),
+                            "{name}@{budget}: a step signature leads its batch"
+                        );
+                    }
+                }
+            }
+            let _ = &lines;
+        }
+    }
+}
+
+#[test]
+fn a_small_document_is_one_request() {
+    for (name, path) in documents() {
+        let (jsonl, ids) = jsonl_and_ids(&path);
+        if jsonl.len() <= BATCH_BUDGET && !path.steps.is_empty() {
+            assert_eq!(pack(&jsonl, &ids, BATCH_BUDGET).len(), 1, "{name}");
+        }
+    }
+}
+
+#[test]
+fn a_path_with_no_steps_packs_to_at_most_one_batch_and_loses_nothing() {
+    let path = Path {
+        path: toolpath::v1::PathIdentity {
+            id: "empty".into(),
+            base: None,
+            head: "none".into(),
+            graph_ref: None,
+        },
+        steps: vec![],
+        meta: None,
+    };
+    let (jsonl, ids) = jsonl_and_ids(&path);
+    let batches = pack(&jsonl, &ids, BATCH_BUDGET);
+    assert!(batches.len() <= 1, "{} batches", batches.len());
+    let all: String = batches.iter().map(|b| b.body.as_str()).collect();
+    assert_eq!(all, jsonl);
+}
+
+#[test]
+fn a_step_over_the_budget_goes_alone_and_everything_still_reassembles() {
+    let mut path = documents()
+        .into_iter()
+        .find(|(_, p)| p.steps.len() >= 3)
+        .unwrap()
+        .1;
+    let big = "y".repeat(5 * 1024 * 1024);
+    path.steps[1] = path.steps[1].clone().with_raw_change("big.bin", big);
+    let (jsonl, ids) = jsonl_and_ids(&path);
+    let batches = pack(&jsonl, &ids, BATCH_BUDGET);
+    let big_batch = batches
+        .iter()
+        .find(|b| b.body.len() > BATCH_BUDGET)
+        .expect("the 5 MiB step is sent over budget, in a batch of its own");
+    assert_eq!(
+        big_batch
+            .body
+            .lines()
+            .filter(|l| l.starts_with(r#"{"Step":"#))
+            .count(),
+        1
+    );
+    let all: String = batches.iter().map(|b| b.body.as_str()).collect();
+    assert_eq!(all, jsonl);
+}
+
+#[test]
+fn a_real_document_repeated_past_4_mib_runs_the_batching_path() {
+    // the largest real path available, its steps repeated under fresh ids until the JSONL is > 4 MiB
+    let (name, base) = documents()
+        .into_iter()
+        .max_by_key(|(_, p)| p.to_jsonl_string().map_or(0, |s| s.len()))
+        .unwrap();
+    let mut path = base.clone();
+    let mut copy = 0;
+    while path.to_jsonl_string().unwrap().len() <= BATCH_BUDGET + 1024 {
+        copy += 1;
+        let tail = path.steps.last().map(|s| s.step.id.clone());
+        for (i, s) in base.steps.iter().enumerate() {
+            let mut s = s.clone();
+            s.step.id = format!("{}~{copy}", s.step.id);
+            s.step.parents = if i == 0 {
+                tail.iter().cloned().collect()
+            } else {
+                s.step
+                    .parents
+                    .iter()
+                    .map(|p| format!("{p}~{copy}"))
+                    .collect()
+            };
+            path.steps.push(s);
+        }
+    }
+    let (jsonl, ids) = jsonl_and_ids(&path);
+    assert!(jsonl.len() > BATCH_BUDGET, "{name}: {} bytes", jsonl.len());
+    let batches = pack(&jsonl, &ids, BATCH_BUDGET);
+    assert!(
+        batches.len() >= 2,
+        "{name}: {} batch(es) for {} bytes",
+        batches.len(),
+        jsonl.len()
+    );
+    assert!(
+        batches.iter().all(|b| b.body.len() <= BATCH_BUDGET
+            || b.body
+                .lines()
+                .filter(|l| l.starts_with(r#"{"Step":"#))
+                .count()
+                == 1),
+        "a batch is over budget with more than one step"
+    );
+    let all: String = batches.iter().map(|b| b.body.as_str()).collect();
+    assert_eq!(all, jsonl);
+}
+
+mod property {
+    use super::*;
+    use proptest::prelude::*;
+    use proptest::test_runner::{Config, RngAlgorithm, TestRng, TestRunner};
+
+    /// A path of `sizes.len()` steps; step i's parents are earlier steps picked by `links`.
+    fn random_path(sizes: &[usize], links: &[usize]) -> Path {
+        let steps = sizes
+            .iter()
+            .enumerate()
+            .map(|(i, &n)| {
+                let mut s =
+                    toolpath::v1::Step::new(format!("s{i}"), "human:alex", "2024-01-01T00:00:00Z")
+                        .with_raw_change("f.rs", "z".repeat(n));
+                if i > 0 {
+                    s = s.with_parent(format!("s{}", links[i] % i));
+                }
+                s
+            })
+            .collect::<Vec<_>>();
+        Path {
+            path: toolpath::v1::PathIdentity {
+                id: "p".into(),
+                base: None,
+                head: format!("s{}", sizes.len() - 1),
+                graph_ref: None,
+            },
+            steps,
+            meta: None,
+        }
+    }
+
+    /// Fixed seed: a failure replays.
+    #[test]
+    fn random_sizes_orders_and_budgets_keep_every_property() {
+        let mut runner = TestRunner::new_with_rng(
+            Config {
+                cases: 200,
+                ..Config::default()
+            },
+            TestRng::from_seed(RngAlgorithm::ChaCha, &[7u8; 32]),
+        );
+        let strat = (
+            prop::collection::vec(0usize..4000, 1..24),
+            prop::collection::vec(0usize..1000, 24),
+            1usize..9000,
+            any::<bool>(),
+        );
+        runner
+            .run(&strat, |(sizes, links, budget, shuffle)| {
+                let mut path = random_path(&sizes, &links);
+                if shuffle {
+                    path.steps.reverse(); // children before parents: stream_paths reorders
+                }
+                let (jsonl, ids) = jsonl_and_ids(&path);
+                let batches = pack(&jsonl, &ids, budget);
+                let all: String = batches.iter().map(|b| b.body.as_str()).collect();
+                prop_assert_eq!(&all, &jsonl);
+                let mut seen = std::collections::HashSet::new();
+                for (bi, b) in batches.iter().enumerate() {
+                    let kinds: Vec<String> = b.body.lines().map(kind).collect();
+                    prop_assert_eq!(
+                        kinds.first().map(String::as_str) == Some("PathOpen"),
+                        bi == 0
+                    );
+                    prop_assert!(
+                        kinds.iter().any(|k| k == "Step")
+                            || (bi + 1 == batches.len() && is_closing_tail(&kinds)),
+                        "batch {} has no step: {:?}",
+                        bi,
+                        kinds
+                    );
+                    let steps = kinds.iter().filter(|k| *k == "Step").count();
+                    prop_assert!(
+                        b.body.len() <= budget || steps == 1,
+                        "batch {} over budget with {} steps",
+                        bi,
+                        steps
+                    );
+                    for l in b.body.lines().filter(|l| l.starts_with(r#"{"Step":"#)) {
+                        let v: serde_json::Value = serde_json::from_str(l).unwrap();
+                        for p in v["Step"]["step"]["parents"]
+                            .as_array()
+                            .into_iter()
+                            .flatten()
+                        {
+                            prop_assert!(seen.contains(p.as_str().unwrap()), "child before parent");
+                        }
+                        seen.insert(v["Step"]["step"]["id"].as_str().unwrap().to_string());
+                    }
+                }
+                Ok(())
+            })
+            .unwrap();
+    }
+}
+
+mod wire {
+    use super::*;
+    use crate::cmd_pathbase::tests::{
+        MockServer, graph_document_json, path_opened, steps_appended,
+    };
+
+    fn body_of(req: &[u8]) -> String {
+        let text = String::from_utf8_lossy(req).into_owned();
+        text.split_once("\r\n\r\n")
+            .map(|(_, b)| b.to_string())
+            .unwrap_or_default()
+    }
+
+    /// With a stub Pathbase that answers every batch, the bodies a streamed upload actually puts
+    /// on the wire (after the graph shell) concatenate to the writer's JSONL for the document:
+    /// the same content a single-request upload carries, in pieces. Only one-path documents,
+    /// so the stub's answers line up with the batches; budget small enough for several batches.
+    #[test]
+    fn a_streamed_upload_puts_the_writers_jsonl_on_the_wire() {
+        let mut checked = 0;
+        for (name, path) in documents() {
+            if path.steps.len() < 2 {
+                continue;
+            }
+            let (jsonl, ids) = jsonl_and_ids(&path);
+            let budget = 4000;
+            let batches = pack(&jsonl, &ids, budget);
+            if batches.len() < 2 {
+                continue;
+            }
+            let n_steps = |b: &Batch| {
+                b.body
+                    .lines()
+                    .filter(|l| l.starts_with(r#"{"Step":"#))
+                    .count()
+            };
+            let mut responses = vec![
+                ("HTTP/1.1 201 Created", graph_document_json()),
+                (
+                    "HTTP/1.1 201 Created",
+                    path_opened(n_steps(&batches[0]), None),
+                ),
+            ];
+            responses.extend(
+                batches[1..]
+                    .iter()
+                    .map(|b| ("HTTP/1.1 200 OK", steps_appended(n_steps(b), None))),
+            );
+            let server = MockServer::start_sequence(responses);
+            let doc = Graph::from_path(path.clone());
+            graphs_post_streamed(
+                &server.base(),
+                "tok",
+                "alex",
+                "pathstash",
+                Some("big"),
+                &doc,
+                false,
+                budget,
+            )
+            .unwrap_or_else(|e| panic!("{name}: {e}"));
+            let reqs = server.requests();
+            let wire: String = reqs[1..].iter().map(|r| body_of(r)).collect();
+            assert_eq!(
+                wire, jsonl,
+                "{name}: the wire carries something other than the writer's JSONL"
+            );
+            checked += 1;
+        }
+        assert!(
+            checked >= 2,
+            "only {checked} documents were large enough to batch"
+        );
+    }
+}
