-[ -n "$CLAUDE_BIN" ] || { say "no claude executable found (set CLAUDE_BIN=...)"; exit 1; }
-CLAUDE_BIN=$(readlink -f "$CLAUDE_BIN")
-[ -x "$CLAUDE_BIN" ] || { say "$CLAUDE_BIN is not executable"; exit 1; }
-say "claude binary: $CLAUDE_BIN"
-
