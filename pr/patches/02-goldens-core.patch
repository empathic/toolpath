+/// `check`'s `qualifier review` step.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum QualifierReview {
+    /// Run it; a missing binary, a failing run, or drifted / missing anchors are problems.
+    Required,
+    /// Skipped on purpose (`--no-qualifier`); reported as an info row.
+    Skip,
+}
+
+/// The `qualifier` binary: $TOOLPATH_GOLDENS_QUALIFIER, else `qualifier` on PATH.
+pub fn qualifier_bin() -> Option<PathBuf> {
+    if let Some(p) = std::env::var_os("TOOLPATH_GOLDENS_QUALIFIER").filter(|p| !p.is_empty()) {
