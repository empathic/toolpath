From 09d60738d5122d45947a05a1c7ae2d9838987ada Mon Sep 17 00:00:00 2001
From: Robert DeLanghe <1240090+bdelanghe@users.noreply.github.com>
Date: Thu, 15 Oct 2026 09:52:02 -0400
Subject: [PATCH] fix(goldens): goldens.sh runs cargo directly when there is no
 flake (main has none since #332)

---
 scripts/goldens.sh | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/scripts/goldens.sh b/scripts/goldens.sh
index e119c60..a6661ec 100755
--- a/scripts/goldens.sh
+++ b/scripts/goldens.sh
@@ -3,4 +3,9 @@
 #   scripts/goldens.sh check | diff <name> | list | init | capture ... | capture-claude
 set -euo pipefail
 cd "$(dirname "$0")/.."
-exec nix develop --command cargo run -q -p path-cli -- goldens "${@:-check}"
+# The dev shell is a flake on wip only (main moved nix packaging off in #332);
+# without one, the pinned rustup toolchain runs cargo directly.
+if [ -f flake.nix ] && command -v nix >/dev/null 2>&1; then
+    exec nix develop --command cargo run -q -p path-cli -- goldens "${@:-check}"
+fi
+exec cargo run -q -p path-cli -- goldens "${@:-check}"
-- 
2.55.0

