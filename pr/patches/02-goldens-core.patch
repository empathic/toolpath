From b7ffa48e0c82296a5ef4ddf3e73ac3af48287ea9 Mon Sep 17 00:00:00 2001
From: Robert DeLanghe <1240090+bdelanghe@users.noreply.github.com>
Date: Wed, 14 Oct 2026 20:53:28 -0400
Subject: [PATCH] feat(goldens): round-trip check fails on newly gained key
 paths

roundtrip_regressions failed on a new lost key path but ignored gained
ones, so a vestigial or invented key appearing after IR -> adapter -> IR
passed. Today's gained paths are already pinned (declared) in each
committed goldens/roundtrip/<set>-<adapter>.json; a gained path not in
that list is now a problem, reported like a new loss. The ok row shows
both counts.
---
 crates/path-cli/src/goldens.rs | 57 +++++++++++++++++++++++-----------
 1 file changed, 39 insertions(+), 18 deletions(-)

diff --git a/crates/path-cli/src/goldens.rs b/crates/path-cli/src/goldens.rs
index a3d4ddd..348aaa9 100644
--- a/crates/path-cli/src/goldens.rs
+++ b/crates/path-cli/src/goldens.rs
@@ -108,7 +108,7 @@ pub enum GoldensCommand {
     /// List the golden sets in the manifest
     List,
     /// Round trips IR -> adapter -> IR for every set and adapter: key paths lost and gained, text
-    /// and tool-use survival (check pins today's losses; a new loss fails)
+    /// and tool-use survival (check pins today's losses and gains; a new one of either fails)
     Roundtrip {
         /// Only this set (default: all)
         name: Option<String>,
@@ -1182,7 +1182,7 @@ impl Goldens {
                                     r.ok.push(if fresh["error"].is_string() {
                                         format!("{label} (cannot round-trip, as pinned)")
                                     } else {
-                                        format!("{label} (loses {} key paths, as pinned)", fresh["lost"].as_array().map_or(0, Vec::len))
+                                        format!("{label} (loses {}, gains {} key paths, as pinned)", fresh["lost"].as_array().map_or(0, Vec::len), fresh["gained"].as_array().map_or(0, Vec::len))
                                     });
                                 } else {
                                     r.problems.extend(regress);
@@ -1725,8 +1725,9 @@ fn row_file(set: &str, adapter: &str) -> String {
     format!("goldens/roundtrip/{set}-{adapter}.json")
 }
 
-/// Problems when a fresh row is worse than the committed one: a loss that was not there before, or
-/// less text / fewer tool uses surviving. Losses that shrank are not problems.
+/// Problems when a fresh row is worse than the committed one: a loss or a gained (vestigial or
+/// invented) key path that was not there before, or less text / fewer tool uses surviving. Losses or
+/// gains that shrank are not problems.
 fn roundtrip_regressions(label: &str, committed: &Value, fresh: &Value) -> Vec<String> {
     match (committed["error"].as_str(), fresh["error"].as_str()) {
         (Some(a), Some(b)) if a == b => return Vec::new(),
@@ -1743,27 +1744,30 @@ fn roundtrip_regressions(label: &str, committed: &Value, fresh: &Value) -> Vec<S
         (None, Some(b)) => return vec![format!("{label}: can no longer round-trip: {b}")],
         (None, None) => {}
     }
-    let set_of = |v: &Value| -> BTreeSet<String> {
-        v["lost"]
+    let set_of = |v: &Value, field: &str| -> BTreeSet<String> {
+        v[field]
             .as_array()
             .into_iter()
             .flatten()
             .filter_map(|x| x.as_str().map(str::to_string))
             .collect()
     };
-    let (old, new) = (set_of(committed), set_of(fresh));
     let mut out = Vec::new();
-    let grown: Vec<_> = new.difference(&old).take(8).collect();
-    if !grown.is_empty() {
-        out.push(format!(
-            "{label}: round trip loses {} key path(s) it did not before, e.g. {}",
-            new.difference(&old).count(),
-            grown
-                .iter()
-                .map(|s| s.as_str())
-                .collect::<Vec<_>>()
-                .join(", ")
-        ));
+    // Lost paths drop information; gained paths are vestigial or invented keys. Today's of each are
+    // pinned (declared) in the committed row; only new ones are problems.
+    for (field, what) in [
+        ("lost", "loses"),
+        ("gained", "gains (vestigial or invented)"),
+    ] {
+        let (old, new) = (set_of(committed, field), set_of(fresh, field));
+        let grown: Vec<&str> = new.difference(&old).map(String::as_str).collect();
+        if !grown.is_empty() {
+            out.push(format!(
+                "{label}: round trip {what} {} key path(s) it did not before, e.g. {}",
+                grown.len(),
+                grown.iter().take(8).copied().collect::<Vec<_>>().join(", ")
+            ));
+        }
     }
     for k in ["text_chars", "tool_uses", "steps"] {
         let (a, b) = (
@@ -3341,6 +3345,23 @@ mod tests {
         assert!(bad.is_empty() && info.len() == 2, "{bad:?} {info:?}");
     }
 
+    #[test]
+    fn roundtrip_fails_on_a_newly_gained_key_path() {
+        // The committed claude -> codex row is "fresh"; the pin is the same row with one gained path
+        // removed, so the fresh run newly gains it.
+        let fresh = committed_json("goldens/roundtrip/claude-codex.json");
+        let mut pinned = fresh.clone();
+        let extra = pinned["gained"].as_array_mut().unwrap().remove(0);
+        let bad = roundtrip_regressions("claude -> codex -> IR", &pinned, &fresh);
+        assert_eq!(bad.len(), 1, "{bad:?}");
+        assert!(
+            bad[0].contains("gains") && bad[0].contains(extra.as_str().unwrap()),
+            "{bad:?}"
+        );
+        assert!(roundtrip_regressions("x", &fresh, &fresh).is_empty());
+        assert!(roundtrip_regressions("x", &fresh, &pinned).is_empty());
+    }
+
     #[test]
     fn credential_plain_routes_by_prefix() {
         let (k, v) = normalize_credential("  sk-ant-oat01-abc\n").unwrap();
-- 
