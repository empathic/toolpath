From 32dfc7a2f591e03e9a5f83e7633afb05e2174095 Mon Sep 17 00:00:00 2001
From: Robert DeLanghe <1240090+bdelanghe@users.noreply.github.com>
Date: Wed, 14 Oct 2026 20:49:54 -0400
Subject: [PATCH] feat(goldens): check recomputes shed per set and fails on
 newly dropped key paths or lost text

The output goldens are all derived from the same IR, so a field the
adapter stops reading (transcript -> IR) left every one of them matching:
dropping user_type in the claude provider kept check green. check now
recomputes the shed report of every set from the run it already made and
compares it to the committed goldens/shed/<set>.json by key-path SET:

- a path newly in same_format.dropped, a new rename, or an event type
  newly shed is a problem ('newly dropped ...: userType');
- fewer IR string_chars/steps/text_chars/tool_uses, or fewer string_chars
  in any projection, is a problem ('text lost');
- pinned drops that disappear, or numbers that grow, are info (the report
  is stale; refresh with path goldens shed --json).

A set without a committed shed report is an info row, not silently skipped.
---
 crates/path-cli/src/goldens.rs | 196 ++++++++++++++++++++++++++++++++-
 1 file changed, 194 insertions(+), 2 deletions(-)

diff --git a/crates/path-cli/src/goldens.rs b/crates/path-cli/src/goldens.rs
index ecef318..a3d4ddd 100644
--- a/crates/path-cli/src/goldens.rs
+++ b/crates/path-cli/src/goldens.rs
@@ -1193,11 +1193,59 @@ impl Goldens {
                     }
                 }
             }
+            // Transcript -> IR: the shed report is recomputed and compared to the committed one, so
+            // a field the adapter stops reading fails here even when every output golden (derived
+            // from the same lossy IR) still matches.
+            let shed_file = format!("goldens/shed/{name}.json");
+            match m["shed"]
+                .as_array()
+                .into_iter()
+                .flatten()
+                .find(|d| d["file"] == shed_file.as_str())
+            {
+                None => r.info.push(format!(
+                    "{name}: no committed shed report {shed_file}; transcript -> IR losses not gated (`path goldens shed {name} --json`)"
+                )),
+                Some(d) => match fs::read(self.root.join(&shed_file)) {
+                    Err(e) => r.problems.push(format!("{shed_file} unreadable: {e}")),
+                    Ok(b) if Some(sha256_hex(&b).as_str()) != d["sha256"].as_str() => r
+                        .problems
+                        .push(format!("{shed_file} does not match the manifest sha256 (hand-edited?)")),
+                    Ok(b) => {
+                        let committed: Value = serde_json::from_slice(&b).unwrap_or(Value::Null);
+                        let label = format!("{name} shed");
+                        match self.shed_of(&name, harness, &run) {
+                            Err(e) => r.problems.push(format!("{label}: {e}")),
+                            Ok(fresh) => {
+                                let (bad, info) = shed_regressions(&label, &committed, &fresh);
+                                r.info.extend(info);
+                                if bad.is_empty() {
+                                    r.ok.push(format!(
+                                        "{label} (drops {} key paths, as pinned)",
+                                        fresh["same_format"]["dropped"]
+                                            .as_array()
+                                            .map_or(0, Vec::len)
+                                    ));
+                                } else {
+                                    r.problems.extend(bad);
+                                }
+                            }
+                        }
+                    }
+                },
+            }
             fresh_runs.push((name, run));
         }
-        // Shed reports are evidence: the files listed in the manifest must be the ones on disk.
+        // Shed reports are evidence: every file listed in the manifest must be the one on disk
+        // (the ones for sets run above were already compared).
         for d in m["shed"].as_array().into_iter().flatten() {
             let file = d["file"].as_str().unwrap_or("?");
+            if fresh_runs
+                .iter()
+                .any(|(n, _)| file == format!("goldens/shed/{n}.json"))
+            {
+                continue;
+            }
             match fs::read(self.root.join(file)) {
                 Ok(b) if Some(sha256_hex(&b).as_str()) == d["sha256"].as_str() => {}
                 Ok(_) => r.problems.push(format!(
@@ -1950,6 +1998,117 @@ fn snake_case(s: &str) -> String {
     out
 }
 
+/// A recomputed shed report against the committed one. Returns (problems, info): a key path newly
+/// dropped or renamed on the same-format round trip, an event type newly shed, or fewer string chars /
+/// steps / text chars / tool uses at any stage is a problem (compared as SETS of key paths, never
+/// index-wise). Losses that shrank, or numbers that grew, are information: the committed report is
+/// stale and `path goldens shed --json` refreshes it on purpose.
+fn shed_regressions(label: &str, committed: &Value, fresh: &Value) -> (Vec<String>, Vec<String>) {
+    let (mut bad, mut info) = (Vec::new(), Vec::new());
+    let (cs, fs_) = (&committed["same_format"], &fresh["same_format"]);
+    match (cs["error"].as_str(), fs_["error"].as_str()) {
+        (None, Some(e)) => bad.push(format!(
+            "{label}: same-format round trip now fails: {e}"
+        )),
+        (Some(_), None) => info.push(format!(
+            "{label}: same-format round trip now succeeds (pinned as failing); refresh with `path goldens shed --json`"
+        )),
+        _ => {}
+    }
+    let paths = |v: &Value, field: &str, key: &str| -> BTreeSet<String> {
+        v[field]
+            .as_array()
+            .into_iter()
+            .flatten()
+            .filter_map(|x| x[key].as_str().map(str::to_string))
+            .collect()
+    };
+    let (old, new) = (paths(cs, "dropped", "path"), paths(fs_, "dropped", "path"));
+    let newly: Vec<&str> = new.difference(&old).map(String::as_str).collect();
+    if !newly.is_empty() {
+        bad.push(format!(
+            "{label}: newly dropped on the same-format round trip ({}): {}",
+            newly.len(),
+            newly.join(", ")
+        ));
+    }
+    let kept: Vec<&str> = old.difference(&new).map(String::as_str).collect();
+    if !kept.is_empty() && fs_["error"].is_null() {
+        info.push(format!(
+            "{label}: no longer dropped: {} (refresh with `path goldens shed --json`)",
+            kept.join(", ")
+        ));
+    }
+    let renames = |v: &Value| -> BTreeSet<String> {
+        v["renamed"]
+            .as_array()
+            .into_iter()
+            .flatten()
+            .map(|r| {
+                format!(
+                    "{} -> {}",
+                    r["from"].as_str().unwrap_or("?"),
+                    r["to"].as_str().unwrap_or("?")
+                )
+            })
+            .collect()
+    };
+    let new_renames: Vec<String> = renames(fs_).difference(&renames(cs)).cloned().collect();
+    if !new_renames.is_empty() {
+        bad.push(format!(
+            "{label}: newly renamed: {}",
+            new_renames.join(", ")
+        ));
+    }
+    for (t, c) in fs_["event_types_shed"].as_object().into_iter().flatten() {
+        // A type absent from the pinned list was kept whole.
+        let pinned_after = cs["event_types_shed"][t]["after"]
+            .as_u64()
+            .or_else(|| c["source"].as_u64())
+            .unwrap_or(0);
+        let after = c["after"].as_u64().unwrap_or(0);
+        if after < pinned_after {
+            bad.push(format!(
+                "{label}: event type {t} newly shed: {after} of {} kept (pinned {pinned_after})",
+                c["source"]
+            ));
+        }
+    }
+    // Numbers: fewer is a loss; more means the committed report is stale.
+    let mut nums: Vec<(String, &Value, &Value)> =
+        ["string_chars", "steps", "text_chars", "tool_uses"]
+            .into_iter()
+            .map(|k| (format!("IR {k}"), &committed["ir"][k], &fresh["ir"][k]))
+            .collect();
+    for p in fresh["projections"].as_array().into_iter().flatten() {
+        if let Some(w) = committed["projections"]
+            .as_array()
+            .into_iter()
+            .flatten()
+            .find(|c| c["target"] == p["target"])
+        {
+            nums.push((
+                format!("-> {} string_chars", p["target"].as_str().unwrap_or("?")),
+                &w["string_chars"],
+                &p["string_chars"],
+            ));
+        }
+    }
+    for (what, was, is) in nums {
+        let (Some(was), Some(is)) = (was.as_u64(), is.as_u64()) else {
+            continue;
+        };
+        if is < was {
+            bad.push(format!("{label}: {what} {is} (pinned {was}): text lost"));
+        } else if is > was {
+            info.push(format!(
+                "{label}: {what} {is} (pinned {was}); refresh with `path goldens shed --json`"
+            ));
+        }
+    }
+    (bad, info)
+}
+
 impl Goldens {
     /// Project an IR document to `target` in a fresh temp HOME (used for the same-format round trip).
     fn project_ir(&self, ir: &[u8], target: &str) -> std::result::Result<Vec<u8>, String> {
@@ -1976,8 +2135,14 @@ impl Goldens {
         let name = e["name"].as_str().unwrap_or("?");
         let harness = Harness::parse(e["harness"]["name"].as_str().unwrap_or(""))?;
         let input = fs::read(self.root.join(e["fixture"].as_str().unwrap_or("")))?;
-        let src = String::from_utf8_lossy(&input).into_owned();
         let run = self.run_set(harness, &input, e["project"].as_str())?;
+        self.shed_of(name, harness, &run)
+    }
+
+    /// The shed report of one run (what `shed --json` writes, and what `check` recomputes).
+    fn shed_of(&self, name: &str, harness: Harness, run: &SetRun) -> Result<Value> {
+        let input = &run.input;
+        let src = String::from_utf8_lossy(input).into_owned();
         let ir: Value = serde_json::from_slice(&run.ir)?;
         let (steps, text_chars, tool_uses) = ir_counts(&ir);
         let projections: Vec<Value> = run
@@ -3149,6 +3314,33 @@ fn resolve_agent(exe: &str, explicit: Option<PathBuf>) -> Result<PathBuf> {
 mod tests {
     use super::*;
 
+    /// A committed golden file, parsed.
+    fn committed_json(rel: &str) -> Value {
+        let root = Path::new(env!("CARGO_MANIFEST_DIR")).join("../..");
+        serde_json::from_slice(&fs::read(root.join(rel)).unwrap()).unwrap()
+    }
+
+    #[test]
+    fn shed_names_a_newly_dropped_path_and_lost_text() {
+        // The committed claude shed report is "fresh"; the pin is the same report with one dropped
+        // path removed and a larger IR, so the fresh run newly drops that path and loses text.
+        let fresh = committed_json("goldens/shed/claude.json");
+        let mut pinned = fresh.clone();
+        let gone = pinned["same_format"]["dropped"]
+            .as_array_mut()
+            .unwrap()
+            .remove(0);
+        pinned["ir"]["string_chars"] = json!(fresh["ir"]["string_chars"].as_u64().unwrap() + 40);
+        let (bad, _) = shed_regressions("claude shed", &pinned, &fresh);
+        assert_eq!(bad.len(), 2, "{bad:?}");
+        assert!(bad[0].contains(gone["path"].as_str().unwrap()), "{bad:?}");
+        assert!(bad[1].contains("IR string_chars"), "{bad:?}");
+        // Unchanged: nothing to report; the reverse direction is information only.
+        assert_eq!(shed_regressions("x", &fresh, &fresh), (vec![], vec![]));
+        let (bad, info) = shed_regressions("x", &fresh, &pinned);
+        assert!(bad.is_empty() && info.len() == 2, "{bad:?} {info:?}");
+    }
+
     #[test]
     fn credential_plain_routes_by_prefix() {
         let (k, v) = normalize_credential("  sk-ant-oat01-abc\n").unwrap();
