From eccddc46356366dcdee2bafd8b76724f83184905 Mon Sep 17 00:00:00 2001
From: Robert DeLanghe <1240090+bdelanghe@users.noreply.github.com>
Date: Wed, 14 Oct 2026 20:58:03 -0400
Subject: [PATCH] fix(goldens): known-defect check tells FIXED from
 changed-and-worse

Any change to a known-defect body was reported as 'the defect may be
FIXED', so projecting stop_reason as None (dropping the field outright, a
worse regression) read as a fix. Each defect now carries a judge:

- illegal types: fixed only when counts fell or types vanished; a new
  type or a higher count is worse;
- caller cwd: fixed only when every written cwd is the source cwd;
- renames: a pinned rename is fixed only when the source path is written
  again under its own name; if neither name is written the field is lost
  outright, which is worse.

Messages: 'looks FIXED (...); recapture on purpose' versus 'CHANGED and is
NOT fixed (...): a regression on top of the defect'.
---
 crates/path-cli/src/goldens.rs | 133 +++++++++++++++++++++++++++++++--
 1 file changed, 128 insertions(+), 5 deletions(-)

diff --git a/crates/path-cli/src/goldens.rs b/crates/path-cli/src/goldens.rs
index 348aaa9..e44e619 100644
--- a/crates/path-cli/src/goldens.rs
+++ b/crates/path-cli/src/goldens.rs
@@ -1265,11 +1265,18 @@ impl Goldens {
             let body = (def.compute)(run, &out);
             match fs::read_to_string(self.root.join(def.file)) {
                 Ok(golden) if golden == body => r.ok.push(format!("known defect {} (still present)", def.file)),
-                Ok(golden) => r.problems.push(format!(
-                    "known defect {} changed: the defect may be FIXED; if so recapture on purpose\n{}",
-                    def.file,
-                    diff(&golden, &body, diff_lines)
-                )),
+                Ok(golden) => r.problems.push(match (def.judge)(run, &out, &golden, &body) {
+                    Verdict::Fixed(why) => format!(
+                        "known defect {} looks FIXED ({why}); recapture on purpose (`path goldens capture --all`) and retire its qualifier record\n{}",
+                        def.file,
+                        diff(&golden, &body, diff_lines)
+                    ),
+                    Verdict::Worse(why) => format!(
+                        "known defect {} CHANGED and is NOT fixed ({why}): a regression on top of the defect\n{}",
+                        def.file,
+                        diff(&golden, &body, diff_lines)
+                    ),
+                }),
                 Err(err) => r.problems.push(format!("known defect {} unreadable: {err}", def.file)),
             }
             let want = m["known_defects"]
@@ -1300,6 +1307,84 @@ struct Defect {
     target: &'static str,
     report: &'static str,
     compute: fn(&SetRun, &[u8]) -> String,
+    /// When the computed body differs from the pinned one: is the defect fixed, or did the output
+    /// change some other way (`judge(run, output, pinned body, fresh body)`)?
+    judge: fn(&SetRun, &[u8], &str, &str) -> Verdict,
+}
+
+/// What a changed known-defect body means.
+#[derive(Debug, PartialEq, Eq)]
+enum Verdict {
+    /// The defect is gone (or shrank) and nothing new appeared.
+    Fixed(String),
+    /// The body changed but not by the defect going away: new entries, or a field lost outright.
+    Worse(String),
+}
+
+/// `key<TAB>count` lines (illegal types): fixed when only counts fell or keys vanished.
+fn judge_counts(_: &SetRun, _: &[u8], pinned: &str, fresh: &str) -> Verdict {
+    let parse = |t: &str| -> BTreeMap<String, u64> {
+        t.lines()
+            .filter_map(|l| l.split_once('\t'))
+            .map(|(k, n)| (k.to_string(), n.trim().parse().unwrap_or(0)))
+            .collect()
+    };
+    let (was, is) = (parse(pinned), parse(fresh));
+    let worse: Vec<String> = is
+        .iter()
+        .filter(|(k, n)| was.get(*k).is_none_or(|w| *n > w))
+        .map(|(k, n)| format!("{k} {} -> {n}", was.get(k).copied().unwrap_or(0)))
+        .collect();
+    if worse.is_empty() {
+        let gone: Vec<&str> = was
+            .keys()
+            .filter(|k| !is.contains_key(*k))
+            .map(String::as_str)
+            .collect();
+        Verdict::Fixed(format!("no longer written: {}", gone.join(", ")))
+    } else {
+        Verdict::Worse(format!("more or new: {}", worse.join(", ")))
+    }
+}
+
+/// `source_cwd` / `written_cwd` lines: fixed only when every written cwd is the source cwd.
+fn judge_cwd(run: &SetRun, _: &[u8], _: &str, fresh: &str) -> Verdict {
+    let src = run.source_cwd.as_deref().unwrap_or("<none>");
+    let written: Vec<&str> = fresh
+        .lines()
+        .filter_map(|l| l.strip_prefix("written_cwd\t"))
+        .collect();
+    if !written.is_empty() && written.iter().all(|w| *w == src) {
+        Verdict::Fixed("every written cwd is the source cwd".into())
+    } else {
+        Verdict::Worse(format!("written cwd now {:?}, source {src}", written))
+    }
+}
+
+/// `source<TAB>written` rename lines: a pinned rename is fixed only when the source path is written
+/// again under its own name; if neither name is written the field is lost outright (worse).
+fn judge_renames(_: &SetRun, out: &[u8], pinned: &str, fresh: &str) -> Verdict {
+    let written = raw_paths(&String::from_utf8_lossy(out));
+    let (was, is): (BTreeSet<&str>, BTreeSet<&str>) =
+        (pinned.lines().collect(), fresh.lines().collect());
+    let mut worse: Vec<String> = is
+        .difference(&was)
+        .map(|l| format!("new rename {}", l.replace('\t', " -> ")))
+        .collect();
+    let mut fixed = Vec::new();
+    for l in was.difference(&is) {
+        let src = l.split('\t').next().unwrap_or(l);
+        if written.contains_key(src) {
+            fixed.push(format!("{src} written again"));
+        } else {
+            worse.push(format!("{src} is no longer written under either name"));
+        }
+    }
+    if worse.is_empty() {
+        Verdict::Fixed(fixed.join(", "))
+    } else {
+        Verdict::Worse(worse.join(", "))
+    }
 }
 
 const DEFECTS: &[Defect] = &[
@@ -1314,6 +1399,7 @@ const DEFECTS: &[Defect] = &[
         target: "claude",
         report: "~/.lobby/ops/toolpath-transform-regression-goal.md (2026-09-29)",
         compute: |_, out| illegal_types(out),
+        judge: judge_counts,
     },
     // Found 2026-10-08: `p export codex -o` writes the CALLER's cwd into every codex `cwd` field instead
     // of the source session's. The harness runs from `/`, so the wrong value is `/`.
@@ -1323,6 +1409,7 @@ const DEFECTS: &[Defect] = &[
         target: "codex",
         report: "~/.lobby/ops/REPORT-demo-goldens-toolpath-2026-10-08.md (found 2026-10-08)",
         compute: caller_cwd,
+        judge: judge_cwd,
     },
     // Found by `shed` 2026-10-08: the claude projection renames `message.stop_reason` (the API field
     // Claude Code reads) to `message.stopReason`; the docs (jsonl-envelope.md) say `stopReason` is a
@@ -1334,6 +1421,7 @@ const DEFECTS: &[Defect] = &[
         target: "self:claude",
         report: "shed finding 2026-10-08; docs/agents/formats/claude-code/jsonl-envelope.md; qualifier concern on the claude projection",
         compute: renamed_fields,
+        judge: judge_renames,
     },
 ];
 
@@ -3362,6 +3450,41 @@ mod tests {
         assert!(roundtrip_regressions("x", &fresh, &pinned).is_empty());
     }
 
+    #[test]
+    fn known_rename_gone_is_fixed_only_if_the_source_name_is_written() {
+        let root = Path::new(env!("CARGO_MANIFEST_DIR")).join("../..");
+        let pinned =
+            fs::read_to_string(root.join("goldens/known-defect/claude-roundtrip-renames.tsv"))
+                .unwrap();
+        let input = fs::read_to_string(root.join("goldens/claude/input.jsonl")).unwrap();
+        let run = SetRun {
+            source_cwd: None,
+            input: input.clone().into_bytes(),
+            ir: Vec::new(),
+            targets: Vec::new(),
+        };
+        // The committed input writes message.stop_reason: an output like it means the rename is fixed.
+        assert!(matches!(
+            judge_renames(&run, input.as_bytes(), &pinned, ""),
+            Verdict::Fixed(_)
+        ));
+        // The same input with stop_reason removed: neither name written, so worse, not fixed.
+        let stripped: String = input
+            .lines()
+            .map(|l| {
+                let mut v: Value = serde_json::from_str(l).unwrap();
+                if let Some(m) = v["message"].as_object_mut() {
+                    m.remove("stop_reason");
+                }
+                v.to_string() + "\n"
+            })
+            .collect();
+        let Verdict::Worse(why) = judge_renames(&run, stripped.as_bytes(), &pinned, "") else {
+            panic!("a field lost outright was reported as fixed");
+        };
+        assert!(why.contains("message.stop_reason"), "{why}");
+    }
+
     #[test]
     fn credential_plain_routes_by_prefix() {
         let (k, v) = normalize_credential("  sk-ant-oat01-abc\n").unwrap();
-- 
