@@ -361,6 +390,64 @@ impl Goldens {
             exe,
             allow_producer_drift: false,
             store_root: PathBuf::from("/nix/store"),
+            qualifier: QualifierReview::Required,
+        }
+    }
+
+    /// Spec rule 11: findings are qualifier records anchored on the code; `qualifier review` must
+    /// run and report no drifted or missing anchor. Fails closed: no binary is a problem unless the
+    /// review was skipped on purpose.
+    fn qualifier_review(&self, r: &mut Report) {
+        if self.qualifier == QualifierReview::Skip {
+            r.info
+                .push("qualifier review skipped on purpose (--no-qualifier)".into());
+            return;
+        }
+        let Some(bin) = qualifier_bin() else {
+            r.problems.push(
+                "qualifier review: no `qualifier` binary ($TOOLPATH_GOLDENS_QUALIFIER or PATH); install it, or pass --no-qualifier to skip the review on purpose".into(),
+            );
+            return;
+        };
+        let out = match Command::new(&bin)
+            .arg("review")
+            .current_dir(&self.root)
+            .output()
+        {
+            Ok(o) => o,
+            Err(e) => {
+                r.problems
+                    .push(format!("qualifier review: {}: {e}", bin.display()));
+                return;
+            }
+        };
+        let text = String::from_utf8_lossy(&out.stdout);
+        // `N annotations checked: a fresh, b drifted, c missing`, or one line when nothing is hashed.
+        let summary = text
+            .lines()
+            .rev()
+            .find(|l| l.contains("annotations checked"))
+            .or_else(|| text.lines().rev().find(|l| !l.trim().is_empty()))
+            .unwrap_or("no output")
+            .trim()
+            .to_string();
+        let count = |word: &str| -> u64 {
+            summary
+                .split(',')
+                .find(|p| p.contains(word))
+                .and_then(|p| p.split_whitespace().rev().nth(1)?.parse().ok())
+                .unwrap_or(0)
+        };
+        if !out.status.success() || count("drifted") > 0 || count("missing") > 0 {
+            let err = String::from_utf8_lossy(&out.stderr);
+            let detail = err.lines().find(|l| !l.trim().is_empty()).unwrap_or("");
+            r.problems.push(
+                format!("qualifier review: {summary} {detail}")
+                    .trim()
+                    .to_string(),
+            );
+        } else {
+            r.ok.push(format!("qualifier review: {summary}"));
         }
     }
 
