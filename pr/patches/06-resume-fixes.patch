From 74f805ffa4fd5a4191f38147bb11b10dbe4822dd Mon Sep 17 00:00:00 2001
From: Robert DeLanghe <1240090+bdelanghe@users.noreply.github.com>
Date: Thu, 15 Oct 2026 10:25:28 -0400
Subject: [PATCH] fix(copilot): a failed tool call keeps its error message, and
 workspace.yaml gets a datetime Copilot accepts
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Two things stood between a projected Copilot session and a resume.

A failed `tool.execution_complete` carries no `result`, only
`error.message` (observed 1.0.68: `{"success":false,"error":{"message":
"Path does not exist","code":"failure"}}`). The reader took `result` only,
so the invocation's result was `is_error: true` with empty content. The
Claude projection wrote that as a `tool_result` with empty content, which
the Anthropic Messages API rejects on the first resumed turn:
`400 messages.N.content.0.tool_result: content cannot be empty if
is_error is true` (measured on copilot -> claude; `claude -p -r` exited 1).
The reader now keeps the error message as the result content, which is
also the text the model saw.

`path resume --harness copilot` writes `workspace.yaml` with chrono's
default RFC 3339 (`…59.997483+00:00`); copilot 1.0.61 rejects it
(`Failed to load workspace …: created_at: Invalid datetime`) and resumes
without the workspace state. Copilot itself writes `…59.997Z`; write that.

Goldens recaptured: the three `copilot -> *` outputs carry the message;
known defects unchanged.
---
 crates/path-cli/src/projection/copilot.rs | 30 ++++++++++++-
 crates/toolpath-copilot/src/provider.rs   | 33 ++++++++++++--
 crates/toolpath-copilot/src/types.rs      | 12 +++++
 goldens/copilot/to-claude.jsonl           |  2 +-
 goldens/copilot/to-codex.jsonl            |  2 +-
 goldens/copilot/to-pi.jsonl               |  6 +--
 goldens/manifest.json                     | 54 +++++++++++------------
 7 files changed, 102 insertions(+), 37 deletions(-)

diff --git a/crates/path-cli/src/projection/copilot.rs b/crates/path-cli/src/projection/copilot.rs
index 0ae6aed..78c6f6b 100644
--- a/crates/path-cli/src/projection/copilot.rs
+++ b/crates/path-cli/src/projection/copilot.rs
@@ -99,9 +99,18 @@ fn write_into_copilot_project(session: &toolpath_copilot::Session) -> Result<()>
     Ok(())
 }
 
+/// The instant, in the shape Copilot CLI writes and validates in
+/// `workspace.yaml` (`2026-10-15T13:50:59.997Z`). The chrono default
+/// (`…59.997483+00:00`) fails its datetime check: copilot 1.0.61 logs
+/// `Failed to load workspace … created_at: Invalid datetime` and resumes
+/// without the workspace state.
+fn copilot_now() -> String {
+    chrono::Utc::now().to_rfc3339_opts(chrono::SecondsFormat::Millis, true)
+}
+
 fn copilot_workspace_yaml(session: &toolpath_copilot::Session) -> String {
     let ws = session.workspace.clone().unwrap_or_default();
-    let now = chrono::Utc::now().to_rfc3339();
+    let now = copilot_now();
     let mut out = String::new();
     out.push_str(&format!("id: {}\n", session.id));
     if let Some(cwd) = &ws.git_root {
@@ -135,7 +144,7 @@ fn register_copilot_session(
     let ws = session.workspace.clone().unwrap_or_default();
     let cwd = ws.git_root.unwrap_or_default();
     let summary = copilot_first_user_message(session);
-    let now = chrono::Utc::now().to_rfc3339();
+    let now = copilot_now();
     conn.execute(
         "INSERT OR REPLACE INTO sessions
             (id, cwd, repository, host_type, branch, summary, created_at, updated_at)
@@ -157,3 +166,20 @@ fn register_copilot_session(
 fn copilot_first_user_message(session: &toolpath_copilot::Session) -> String {
     session.first_user_text().unwrap_or_default()
 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn workspace_timestamps_are_millisecond_utc_z() {
+        // `2026-10-15T13:50:59.997Z`: 24 chars, `Z`, three fractional digits —
+        // the only shape copilot's workspace.yaml validator accepts.
+        let now = copilot_now();
+        assert_eq!(now.len(), 24, "{now}");
+        assert!(now.ends_with('Z'), "{now}");
+        assert_eq!(&now[19..20], ".", "{now}");
+        assert!(now[20..23].chars().all(|c| c.is_ascii_digit()), "{now}");
+        assert!(!now.contains("+00:00"), "{now}");
+    }
+}
diff --git a/crates/toolpath-copilot/src/provider.rs b/crates/toolpath-copilot/src/provider.rs
index 430ef66..fe69e69 100644
--- a/crates/toolpath-copilot/src/provider.rs
+++ b/crates/toolpath-copilot/src/provider.rs
@@ -227,10 +227,17 @@ pub fn to_view(session: &Session) -> ConversationView {
                 {
                     upgrade_mutation_diff(&mut current, &mut turns, id, det);
                 }
-                let result = ToolResult {
-                    content: te.output.clone().unwrap_or_default(),
-                    is_error: te.success == Some(false),
+                // A failed call carries no `result`, only `error.message`;
+                // that message is what the model saw, so it is the result.
+                // (An errored result with empty content is also rejected by
+                // the Anthropic Messages API when a projection replays it.)
+                let is_error = te.success == Some(false);
+                let content = match (te.output.clone(), is_error) {
+                    (Some(out), _) if !out.is_empty() => out,
+                    (_, true) => te.error.clone().unwrap_or_default(),
+                    (out, false) => out.unwrap_or_default(),
                 };
+                let result = ToolResult { content, is_error };
                 if !attach_tool_result(
                     &mut current,
                     &mut turns,
@@ -745,6 +752,26 @@ mod tests {
         .join("\n")
     }
 
+    #[test]
+    fn failed_tool_call_keeps_its_error_message_as_the_result() {
+        // Shaped after copilot 1.0.68: a failed `view` has no `result`, only
+        // `error.message`. That text is the result the model saw; an errored
+        // result with empty content is also rejected by the Anthropic API
+        // when a projection replays it.
+        let body = [
