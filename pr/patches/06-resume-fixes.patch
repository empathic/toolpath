From 23f48da1130a49de425757008e36f3ff8dd8809f Mon Sep 17 00:00:00 2001
From: Robert DeLanghe <1240090+bdelanghe@users.noreply.github.com>
Date: Thu, 15 Oct 2026 10:33:59 -0400
Subject: [PATCH] fix(claude): never project an errored tool_result with empty
 content
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A cross-harness source that recorded only a tool call's failure (no output
text) projected as `{"type":"tool_result","content":"","is_error":true}`.
Claude Code loads that file, but the first resumed turn replays the
transcript to the Messages API, which rejects it:
`400 messages.14.content.0.tool_result: content cannot be empty if
is_error is true` — `claude -p -r <id>` exits 1 (measured on the copilot
golden projected to claude, 2.1.285). The synthesized result now carries a
stand-in text when the source left it empty; sources that do carry text are
unchanged. Hard rule 4 in writing-compatible-jsonl.md records it.

Goldens recaptured: `copilot -> claude` carries the stand-in; known defects
unchanged.
---
 crates/toolpath-claude/src/project.rs         | 56 ++++++++++++++++++-
 .../claude-code/writing-compatible-jsonl.md   | 18 ++++++
 goldens/copilot/to-claude.jsonl               |  2 +-
 goldens/manifest.json                         | 50 ++++++++---------
 4 files changed, 99 insertions(+), 27 deletions(-)

diff --git a/crates/toolpath-claude/src/project.rs b/crates/toolpath-claude/src/project.rs
index c0d2480..9127cd2 100644
--- a/crates/toolpath-claude/src/project.rs
+++ b/crates/toolpath-claude/src/project.rs
@@ -56,6 +56,12 @@ impl ConversationProjector for ClaudeProjector {
 /// points at — synthesizing a new one breaks the chain.
 const TOOL_RESULT_USER_EVENT: &str = "tool_result_user";
 
+/// Stand-in text for an errored tool result whose source recorded no
+/// output: the Messages API rejects an `is_error` tool_result with empty
+/// content, which would fail the first resumed turn (hard rule 4 in
+/// `docs/agents/formats/claude-code/writing-compatible-jsonl.md`).
+const EMPTY_ERROR_RESULT_TEXT: &str = "(tool call failed; the source session recorded no output)";
+
 fn project_view(view: &ConversationView) -> std::result::Result<Conversation, String> {
     let mut convo = Conversation::new(view.id.clone());
 
@@ -623,9 +629,19 @@ fn tool_result_entries(turn: &Turn, session_id: &str) -> Vec<ConversationEntry>
         .iter()
         .filter_map(|tu| {
             let result = tu.result.as_ref()?;
+            // The Messages API rejects a replayed transcript holding an
+            // errored tool_result with empty content ("content cannot be
+            // empty if `is_error` is true"), so a resume of the projected
+            // session fails on its first turn. A source that recorded only
+            // the failure (no text) gets a stand-in, never empty text.
+            let content = if result.is_error && result.content.trim().is_empty() {
+                EMPTY_ERROR_RESULT_TEXT.to_string()
+            } else {
+                result.content.clone()
+            };
             let part = ContentPart::ToolResult {
                 tool_use_id: tu.id.clone(),
-                content: ToolResultContent::Text(result.content.clone()),
+                content: ToolResultContent::Text(content),
                 is_error: result.is_error,
             };
 
@@ -1439,6 +1455,44 @@ mod tests {
 
     // ── Test 6: No tool result entry when tool uses have no results ───
 
+    #[test]
+    fn test_errored_tool_result_without_output_is_never_empty() {
+        // A source that recorded only the failure (a copilot reader that
+        // dropped `error.message`; a pi or codex result whose text is "")
+        // must not project an `is_error` tool_result with empty content:
+        // the API rejects the replayed transcript on the first resumed turn
+        // (measured: `400 … tool_result: content cannot be empty if
+        // is_error is true`).
+        let mut turn = assistant_turn("a1", "Reading a missing file.");
+        turn.tool_uses = vec![ToolInvocation {
+            id: "t1".to_string(),
+            name: "Read".to_string(),
+            input: serde_json::json!({"file_path": "nope.txt"}),
+            result: Some(ToolResult {
+                content: String::new(),
+                is_error: true,
+            }),
+            category: None,
+        }];
+        let view = make_view("sess-1", vec![user_turn("u1", "Go"), turn]);
+        let convo = ClaudeProjector.project(&view).unwrap();
+        let entries = content_entries(&convo);
+        let msg = entries[2].message.as_ref().unwrap();
+        match msg.content.as_ref().unwrap() {
+            MessageContent::Parts(parts) => match &parts[0] {
+                ContentPart::ToolResult {
+                    content, is_error, ..
+                } => {
+                    assert!(is_error);
+                    assert!(!content.text().trim().is_empty());
+                    assert_eq!(content.text(), EMPTY_ERROR_RESULT_TEXT);
+                }
+                other => panic!("Expected ToolResult, got {:?}", other),
+            },
+            other => panic!("Expected Parts, got {:?}", other),
+        }
+    }
+
     #[test]
     fn test_no_tool_result_entry_when_no_results() {
         let mut turn = assistant_turn("a1", "Reading...");
diff --git a/docs/agents/formats/claude-code/writing-compatible-jsonl.md b/docs/agents/formats/claude-code/writing-compatible-jsonl.md
index e2b008f..47462e7 100644
--- a/docs/agents/formats/claude-code/writing-compatible-jsonl.md
+++ b/docs/agents/formats/claude-code/writing-compatible-jsonl.md
@@ -72,6 +72,24 @@ and `worktreePath` inside `worktree-state.worktreeSession`. How the
 loader uses them on resume is not known. A writer that moves a session
 to another directory decides for each whether to rewrite it.
 
+### 4. An errored `tool_result` must have content
+
+The loader accepts it, but the first resumed turn replays the transcript
+to the Messages API, which rejects a `tool_result` with `is_error: true`
+and empty content: `400 messages.N.content.0.tool_result: content cannot
+be empty if \`is_error\` is true` (`claude -p -r` exits 1, measured
+2026-10-15 on 2.1.285). A source that recorded only the failure (no
+output text) must get a stand-in text; the projector writes
+`(tool call failed; the source session recorded no output)`.
+
+```jsonc
+// ❌ Rejected on the next turn
+{"type": "tool_result", "tool_use_id": "t1", "content": "", "is_error": true}
+
+// ✅ Correct
+{"type": "tool_result", "tool_use_id": "t1", "content": "Path does not exist", "is_error": true}
+```
+
 ## Strong conventions
 
 Real Claude Code entries always carry these envelope fields. The
