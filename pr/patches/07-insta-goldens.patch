diff --git a/crates/toolpath-goldens/src/canonical.rs b/crates/toolpath-goldens/src/canonical.rs
new file mode 100644
index 0000000..8273981
--- /dev/null
+++ b/crates/toolpath-goldens/src/canonical.rs
@@ -0,0 +1,68 @@
+//! The stable form of a projection that differs between identical runs.
+//! `path p export copilot` mints a random session id and emits keys in
+//! unstable order, so its golden is the canonical form: keys sorted, the
+//! session id masked.
+
+use serde_json::Value;
+
+/// Keys sorted on every line, and the Copilot session id (the first
+/// `data.sessionId`) replaced by `<session-id>` wherever it occurs. Lines
+/// that are not JSON pass through. Every line ends in a newline.
+pub fn canonicalize(text: &str) -> String {
+    let id = text
+        .lines()
+        .filter_map(|l| serde_json::from_str::<Value>(l).ok())
+        .find_map(|v| v["data"]["sessionId"].as_str().map(str::to_owned));
+    let masked = match id {
+        Some(id) => text.replace(&id, "<session-id>"),
+        None => text.to_owned(),
+    };
+    masked
+        .lines()
+        .map(|l| match serde_json::from_str::<Value>(l) {
+            Ok(v) => serde_json::to_string(&sorted(v)).unwrap_or_default() + "\n",
+            Err(_) => l.to_owned() + "\n",
+        })
+        .collect()
+}
+
+fn sorted(v: Value) -> Value {
+    match v {
+        Value::Object(m) => {
+            let mut kv: Vec<_> = m.into_iter().collect();
+            kv.sort_by(|a, b| a.0.cmp(&b.0));
+            Value::Object(kv.into_iter().map(|(k, v)| (k, sorted(v))).collect())
+        }
+        Value::Array(a) => Value::Array(a.into_iter().map(sorted).collect()),
+        other => other,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn keys_are_sorted_and_the_session_id_is_masked_everywhere() {
+        let raw = "{\"z\":1,\"data\":{\"sessionId\":\"abc-1\"},\"a\":\"abc-1\"}";
+        assert_eq!(
+            canonicalize(raw),
+            "{\"a\":\"<session-id>\",\"data\":{\"sessionId\":\"<session-id>\"},\"z\":1}\n"
+        );
+    }
+
+    #[test]
+    fn two_runs_that_differ_only_by_id_and_order_canonicalize_alike() {
+        let a = "{\"type\":\"session.start\",\"data\":{\"sessionId\":\"1111\",\"v\":1}}\n{\"type\":\"user.message\",\"data\":{\"content\":\"hi\"},\"id\":\"1111\"}\n";
+        let b = "{\"data\":{\"v\":1,\"sessionId\":\"2222\"},\"type\":\"session.start\"}\n{\"id\":\"2222\",\"type\":\"user.message\",\"data\":{\"content\":\"hi\"}}\n";
+        assert_eq!(canonicalize(a), canonicalize(b));
+    }
+
+    #[test]
+    fn non_json_lines_pass_through() {
+        assert_eq!(
+            canonicalize("not json\n{\"b\":1,\"a\":2}"),
+            "not json\n{\"a\":2,\"b\":1}\n"
+        );
+    }
+}
diff --git a/crates/toolpath-goldens/src/defects.rs b/crates/toolpath-goldens/src/defects.rs
new file mode 100644
index 0000000..e8f0279
--- /dev/null
+++ b/crates/toolpath-goldens/src/defects.rs
@@ -0,0 +1,223 @@
+//! Known defects, pinned as expected current behaviour. Each one is a
+//! measurement over a set's outputs; the snapshot holds the measurement, so a
+//! fix (or a regression on top of the defect) shows as a snapshot diff.
+
+use std::collections::{BTreeMap, BTreeSet};
+
+use crate::keypaths::{json_lines, raw_paths};
+use crate::model::{Agent, Finding, KnownDefect, Set};
+use crate::shed::renames;
+
+/// The outputs a defect can be measured on.
+pub struct Evidence<'a> {
+    pub set: &'a Set,
+    pub projections: &'a BTreeMap<Agent, String>,
+    /// The set projected back to its own format.
+    pub same_format: &'a str,
+}
+
+/// Which output a defect is measured on.
+#[derive(Clone, Copy)]
+enum Target {
+    Projection(Agent),
+    SameFormat,
+}
+
+impl Target {
+    fn name(self) -> String {
+        match self {
+            Target::Projection(a) => a.name().to_owned(),
+            Target::SameFormat => "self".to_owned(),
+        }
+    }
+}
+
+struct Defect {
+    name: &'static str,
+    set: &'static str,
+    target: Target,
+    measure: fn(&Evidence) -> Finding,
+}
+
+/// Every known defect, in the order they were found.
+const DEFECTS: &[Defect] = &[
+    // `toolpath-claude/src/project.rs::project_event` writes a foreign event's
+    // raw `event_type` as the Claude entry's `type`, so codex -> claude output
+    // carries codex's wire vocabulary that real Claude Code does not define.
+    // Unchanged since the projector's first commit; no other test fails
+    // because toolpath-claude's reader is lenient about `type`.
+    Defect {
+        name: "codex-to-claude-illegal-types",
+        set: "codex",
+        target: Target::Projection(Agent::Claude),
+        measure: |e| illegal_claude_types(&e.projections[&Agent::Claude]),
+    },
+    // `path p export codex -o` writes the CALLER's cwd into every codex `cwd`
+    // field instead of the source session's. The pipeline projects from
+    // [`crate::pipeline::CALLER_CWD`], so the wrong value is that.
+    Defect {
+        name: "claude-to-codex-caller-cwd",
+        set: "claude",
+        target: Target::Projection(Agent::Codex),
+        measure: |e| caller_cwd(&e.set.text(), &e.projections[&Agent::Codex]),
+    },
+    // The claude projection renames `message.stop_reason` (the API field
+    // Claude Code reads) to `message.stopReason`; the docs
+    // (jsonl-envelope.md) say `stopReason` is a different, hook-provided
+    // envelope field. Pinned as every rename the same-format round trip makes.
+    Defect {
+        name: "claude-roundtrip-renames",
+        set: "claude",
+        target: Target::SameFormat,
+        measure: |e| round_trip_renames(&e.set.text(), e.same_format),
+    },
+];
+
+/// The defects that apply to `evidence.set`, measured.
+pub fn known_defects(evidence: &Evidence) -> Vec<KnownDefect> {
+    DEFECTS
+        .iter()
+        .filter(|d| d.set == evidence.set.name)
+        .map(|d| KnownDefect {
+            name: d.name,
+            target: d.target.name(),
+            finding: (d.measure)(evidence),
+        })
+        .collect()
+}
+
+/// Top-level `type` values documented for Claude Code
+/// (docs/agents/formats/claude-code/entry-types.md).
+const CLAUDE_TYPES: &[&str] = &[
+    "user",
+    "assistant",
+    "system",
+    "attachment",
+    "file-history-snapshot",
+    "permission-mode",
+    "queue-operation",
+    "last-prompt",
+    "summary",
+    "compact_boundary",
+    "progress",
+    "ai-title",
+    "custom-title",
+    "agent-name",
+    "mode",
+    "atis-latch",
+    "pr-link",
+    "frame-link",
+    "relocated",
+    "worktree-state",
+];
+
+/// Lines of a Claude projection whose `type` Claude Code does not define,
+/// counted per type.
+pub fn illegal_claude_types(projection: &str) -> Finding {
+    let mut counts = BTreeMap::new();
+    for v in json_lines(projection) {
+        let t = v["type"].as_str().unwrap_or("<no type>");
+        if !CLAUDE_TYPES.contains(&t) {
+            *counts.entry(t.to_owned()).or_default() += 1;
+        }
+    }
+    Finding::IllegalClaudeTypes { counts }
+}
+
+/// The session's own cwd (the first `cwd` in the transcript) against every
+/// `payload.cwd` a codex projection writes.
+pub fn caller_cwd(source: &str, projection: &str) -> Finding {
+    let source_cwd = json_lines(source).find_map(|v| v["cwd"].as_str().map(str::to_owned));
+    let written_cwd: BTreeSet<String> = json_lines(projection)
+        .filter_map(|v| v["payload"]["cwd"].as_str().map(str::to_owned))
+        .collect();
+    Finding::CallerCwd {
+        source_cwd,
+        written_cwd,
+    }
+}
+
+/// Every field the same-format round trip writes under the other spelling.
+pub fn round_trip_renames(source: &str, back: &str) -> Finding {
+    let (before, after) = (raw_paths(source), raw_paths(back));
+    let lost: Vec<&String> = before.keys().filter(|k| !after.contains_key(*k)).collect();
+    let gained: Vec<&String> = after.keys().filter(|k| !before.contains_key(*k)).collect();
+    Finding::Renames {
+        renames: renames(&lost, &gained),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::model::Rename;
+
+    #[test]
+    fn foreign_types_are_counted_and_documented_ones_are_not() {
+        let text = "{\"type\":\"user\"}\n{\"type\":\"agent_message\"}\n{\"type\":\"agent_message\"}\n{\"x\":1}\n";
+        let Finding::IllegalClaudeTypes { counts } = illegal_claude_types(text) else {
+            unreachable!()
+        };
+        assert_eq!(counts.get("agent_message"), Some(&2));
+        assert_eq!(counts.get("<no type>"), Some(&1));
+        assert_eq!(counts.get("user"), None);
+    }
+
+    #[test]
+    fn caller_cwd_pairs_the_source_cwd_with_every_written_one() {
+        let source = "{\"type\":\"user\",\"cwd\":\"/work\"}\n";
+        let projection = "{\"type\":\"session_meta\",\"payload\":{\"cwd\":\"/\"}}\n{\"type\":\"turn_context\",\"payload\":{\"cwd\":\"/\"}}\n";
+        assert_eq!(
+            caller_cwd(source, projection),
+            Finding::CallerCwd {
+                source_cwd: Some("/work".into()),
+                written_cwd: BTreeSet::from(["/".to_owned()]),
+            }
+        );
+    }
+
+    #[test]
+    fn a_rename_is_a_lost_path_written_again_in_the_other_spelling() {
+        let source = "{\"message\":{\"stop_reason\":\"end\"}}\n";
+        let renamed = "{\"message\":{\"stopReason\":\"end\"}}\n";
+        assert_eq!(
+            round_trip_renames(source, renamed),
+            Finding::Renames {
+                renames: vec![Rename {
+                    from: "message.stop_reason".into(),
+                    to: "message.stopReason".into()
+                }]
+            }
+        );
+        // Written under its own name again: no rename (the defect is fixed).
+        assert_eq!(
+            round_trip_renames(source, source),
+            Finding::Renames { renames: vec![] }
+        );
+        // Written under neither name: no rename either; that is a dropped
+        // field, which the shed snapshot shows.
+        assert_eq!(
+            round_trip_renames(source, "{\"message\":{}}\n"),
+            Finding::Renames { renames: vec![] }
+        );
+    }
+
+    #[test]
+    fn only_the_defects_of_the_named_set_apply() {
+        let set = Set::new(
+            "codex",
+            b"{\"type\":\"session_meta\",\"payload\":{\"id\":\"x\"}}\n".to_vec(),
+        )
+        .unwrap();
+        let projections =
+            BTreeMap::from([(Agent::Claude, "{\"type\":\"token_count\"}\n".to_owned())]);
+        let found = known_defects(&Evidence {
+            set: &set,
+            projections: &projections,
+            same_format: "",
+        });
+        assert_eq!(found.len(), 1);
+        assert_eq!(found[0].name, "codex-to-claude-illegal-types");
+        assert_eq!(found[0].target, "claude");
+    }
+}
diff --git a/crates/toolpath-goldens/src/keypaths.rs b/crates/toolpath-goldens/src/keypaths.rs
new file mode 100644
index 0000000..92173e2
--- /dev/null
+++ b/crates/toolpath-goldens/src/keypaths.rs
@@ -0,0 +1,204 @@
+//! Key paths: where a value sits in a JSON document, with everything that
+//! varies between two derivations of the same session collapsed, so documents
+//! compare by structure, not by identity.
+
+use std::collections::{BTreeMap, BTreeSet};
+use std::fmt;
+
+use serde_json::Value;
+
+use crate::model::Counts;
+
+/// A generalised path into a toolpath document: array indices collapsed to
+/// `[]`, artifact-URL keys (whose text embeds a session id) to `<artifact>`,
+/// actor-id keys to `<actor>`. `paths[].steps[].change.<artifact>.structural.text`.
+#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord, serde::Serialize)]
+#[serde(transparent)]
+pub struct KeyPath(String);
+
+impl KeyPath {
+    pub fn as_str(&self) -> &str {
+        &self.0
+    }
+}
+
+impl fmt::Display for KeyPath {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(&self.0)
+    }
+}
+
+/// Every leaf's generalised path in a toolpath document, once each.
+pub fn key_paths(doc: &Value) -> BTreeSet<KeyPath> {
+    fn walk(prefix: &str, v: &Value, out: &mut BTreeSet<KeyPath>) {
+        match v {
+            Value::Object(m) => {
+                for (k, x) in m {
+                    let seg = if k.contains("://") {
+                        "<artifact>"
+                    } else if prefix.ends_with("actors") {
+                        "<actor>"
+                    } else {
+                        k.as_str()
+                    };
+                    walk(&format!("{prefix}.{seg}"), x, out);
+                }
+            }
+            Value::Array(a) => a.iter().for_each(|x| walk(&format!("{prefix}[]"), x, out)),
+            _ => {
+                out.insert(KeyPath(prefix.trim_start_matches('.').to_string()));
+            }
+        }
+    }
+    let mut out = BTreeSet::new();
+    walk("", doc, &mut out);
+    out
+}
+
+/// Leaf paths (arrays collapsed, keys kept) of every JSON line of a
+/// transcript, each with the first example value seen. Lines that are not
+/// JSON are skipped.
+pub fn raw_paths(text: &str) -> BTreeMap<String, String> {
+    fn walk(prefix: &str, v: &Value, out: &mut BTreeMap<String, String>) {
+        match v {
+            Value::Object(m) => m
+                .iter()
+                .for_each(|(k, x)| walk(&format!("{prefix}.{k}"), x, out)),
+            Value::Array(a) => a.iter().for_each(|x| walk(&format!("{prefix}[]"), x, out)),
+            leaf => {
+                let s = match leaf {
+                    Value::String(s) => s.clone(),
+                    other => other.to_string(),
+                };
+                out.entry(prefix.trim_start_matches('.').to_string())
+                    .or_insert(s);
+            }
+        }
+    }
+    let mut out = BTreeMap::new();
+    for line in json_lines(text) {
+        walk("", &line, &mut out);
+    }
+    out
+}
+
+/// Every line of `text` that parses as JSON.
+pub fn json_lines(text: &str) -> impl Iterator<Item = Value> + '_ {
+    text.lines()
+        .filter_map(|l| serde_json::from_str::<Value>(l).ok())
+}
+
+/// `camelCase` -> `camel_case`, so a rename between the two spellings
+/// compares equal.
+pub fn snake_case(s: &str) -> String {
+    let mut out = String::with_capacity(s.len());
+    for c in s.chars() {
+        if c.is_ascii_uppercase() {
+            out.push('_');
+            out.push(c.to_ascii_lowercase());
+        } else {
+            out.push(c);
+        }
+    }
+    out
+}
+
+/// Steps, conversation text characters, tool uses and distinct key paths of
+/// a toolpath document.
+pub fn counts(doc: &Value) -> Counts {
+    fn walk(v: &Value, c: &mut Counts) {
+        match v {
+            Value::Object(m) => {
+                if m.get("type").and_then(Value::as_str) == Some("conversation.append") {
+                    c.text_chars += m
+                        .get("text")
+                        .and_then(Value::as_str)
+                        .map_or(0, |t| t.chars().count());
+                    c.tool_uses += m
+                        .get("tool_uses")
+                        .and_then(Value::as_array)
+                        .map_or(0, Vec::len);
+                }
+                if m.contains_key("step") && m.contains_key("change") {
+                    c.steps += 1;
+                }
+                m.values().for_each(|x| walk(x, c));
+            }
+            Value::Array(a) => a.iter().for_each(|x| walk(x, c)),
+            _ => {}
+        }
+    }
+    let mut c = Counts::default();
+    walk(doc, &mut c);
+    c.key_paths = key_paths(doc).len();
+    c
+}
+
+/// Characters in every string value of a JSON value, summed.
+pub fn string_chars(v: &Value) -> usize {
+    match v {
+        Value::String(s) => s.chars().count(),
+        Value::Array(a) => a.iter().map(string_chars).sum(),
+        Value::Object(m) => m.values().map(string_chars).sum(),
+        _ => 0,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    fn paths(v: &Value) -> Vec<String> {
+        key_paths(v).iter().map(|k| k.to_string()).collect()
+    }
+
+    #[test]
+    fn indices_artifact_urls_and_actor_ids_are_collapsed() {
+        let doc = json!({
+            "paths": [{
+                "steps": [
+                    { "change": { "claude-code://sess-1": { "structural": { "text": "a" } } } },
+                    { "change": { "claude-code://sess-2": { "structural": { "text": "b" } } } }
+                ],
+                "actors": { "user:alice": { "role": "user" }, "agent:claude": { "role": "agent" } }
+            }]
+        });
+        assert_eq!(
+            paths(&doc),
+            vec![
+                "paths[].actors.<actor>.role",
+                "paths[].steps[].change.<artifact>.structural.text",
+            ]
+        );
+    }
+
+    #[test]
+    fn raw_paths_keep_the_first_example_per_path() {
+        let text = "{\"a\":{\"b\":[1,2]},\"t\":\"x\"}\n{\"a\":{\"b\":[3]},\"t\":\"y\"}\nnot json\n";
+        let got = raw_paths(text);
+        assert_eq!(got.get("a.b[]").map(String::as_str), Some("1"));
+        assert_eq!(got.get("t").map(String::as_str), Some("x"));
+        assert_eq!(got.len(), 2);
+    }
+
+    #[test]
+    fn counts_see_steps_text_and_tool_uses() {
+        let doc = json!({ "paths": [{ "steps": [{
+            "step": { "id": "s" },
+            "change": { "claude-code://s": { "structural": {
+                "type": "conversation.append", "text": "hello", "tool_uses": [{ "id": "t" }]
+            } } }
+        }] }] });
+        let c = counts(&doc);
+        assert_eq!((c.steps, c.text_chars, c.tool_uses), (1, 5, 1));
+        assert_eq!(c.key_paths, key_paths(&doc).len());
+    }
+
+    #[test]
+    fn snake_case_and_string_chars() {
+        assert_eq!(snake_case("stopReason"), "stop_reason");
+        assert_eq!(snake_case("stop_reason"), "stop_reason");
+        assert_eq!(string_chars(&json!({"a": ["xy", 1], "b": {"c": "z"}})), 3);
+    }
+}
