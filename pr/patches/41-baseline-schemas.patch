+      "description": "Size of a toolpath document: steps, conversation text, tool uses, and distinct generalised key paths.",
+      "properties": {
+        "key_paths": {
+          "format": "uint",
+          "minimum": 0.0,
+          "type": "integer"
+        },
+        "steps": {
+          "format": "uint",
+          "minimum": 0.0,
+          "type": "integer"
+        },
+        "text_chars": {
+          "format": "uint",
+          "minimum": 0.0,
+          "type": "integer"
+        },
+        "tool_uses": {
+          "format": "uint",
+          "minimum": 0.0,
+          "type": "integer"
+        }
+      },
+      "required": [
+        "key_paths",
+        "steps",
+        "text_chars",
+        "tool_uses"
+      ],
+      "type": "object"
+    }
+  },
+  "description": "One recording's document projected into another harness, read back by that harness's own reader and derived again: what survived, what was lost, what was gained.",
+  "oneOf": [
+    {
+      "description": "The adapter read its projection; this is what survived.",
+      "properties": {
+        "after": {
+          "$ref": "#/definitions/Counts"
+        },
+        "before": {
+          "$ref": "#/definitions/Counts"
+        },
+        "gained": {
