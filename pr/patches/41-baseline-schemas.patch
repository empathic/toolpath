+          "description": "Key paths of the document absent after the round trip.",
+          "items": {
+            "type": "string"
+          },
+          "type": "array"
+        },
+        "outcome": {
+          "enum": [
+            "compared"
+          ],
+          "type": "string"
+        }
+      },
+      "required": [
+        "after",
+        "before",
+        "gained",
+        "lost",
+        "outcome"
+      ],
+      "type": "object"
+    },
+    {
