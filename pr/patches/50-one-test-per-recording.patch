+        // The tests own HOME: every store an adapter might resolve points into
+        // a directory that is empty and a leak needle below.
+        let home = tempfile::tempdir().expect("temp HOME");
+        point_every_store_at(home.path());
+        (real_home, home)
+    })
+}
