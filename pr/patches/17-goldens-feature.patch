From 08c6a6b7055609296eb0fab32d16239277435752 Mon Sep 17 00:00:00 2001
From: Robert DeLanghe <1240090+bdelanghe@users.noreply.github.com>
Date: Mon, 19 Oct 2026 13:13:16 -0400
Subject: [PATCH] feat(path-cli): `path goldens` behind a `goldens` feature,
 off by default

The goldens tool shipped in the release binary (gated only off emscripten).
It is now a Cargo feature like resume-remote; the goldens tests declare
required-features, and every gate (quality_gates.sh, justfile, pr/cut.sh,
pr/gate-piece.sh) builds with --features path-cli/goldens so they still run
on every PR instead of skipping. scripts/goldens.sh enables it. A unit test
asserts the subcommand exists exactly when the feature is on. pr/17 records
the piece.
---
 crates/path-cli/Cargo.toml | 13 ++++++++++++
 crates/path-cli/src/lib.rs | 17 +++++++++++++---
 justfile                   |  2 +-
 pr/17-goldens-feature.md   | 41 ++++++++++++++++++++++++++++++++++++++
 pr/cut.sh                  |  6 +++---
 pr/gate-piece.sh           |  6 +++---
 scripts/goldens.sh         |  4 ++--
 scripts/quality_gates.sh   |  6 +++---
 8 files changed, 80 insertions(+), 15 deletions(-)
 create mode 100644 pr/17-goldens-feature.md

diff --git a/crates/path-cli/Cargo.toml b/crates/path-cli/Cargo.toml
index 2acfccf3..fa341feb 100644
--- a/crates/path-cli/Cargo.toml
+++ b/crates/path-cli/Cargo.toml
@@ -101,6 +101,19 @@ embedded-picker = ["dep:skim", "dep:regex"]
 # `--cwd`, `path resume --remote`, `--dry-run`, and the ssh transport
 # module. Pulls in the in-process SSH client.
 resume-remote = ["dep:serde_json_canonicalizer", "dep:shlex", "dep:russh", "dep:url", "dep:typed-path"]
+# Hermetic goldens (`path goldens`, scripts/goldens.sh): a development
+# tool, off by default so the release binary does not carry it. The
+# quality gates build with `--features path-cli/goldens`, so the goldens
+# tests run on every gate rather than skipping.
+goldens = []
+
+[[test]]
+name = "goldens"
+required-features = ["goldens"]
+
+[[test]]
+name = "goldens_producer"
+required-features = ["goldens"]
 
 [dev-dependencies]
 assert_cmd = "2"
diff --git a/crates/path-cli/src/lib.rs b/crates/path-cli/src/lib.rs
index e52650dd..f9b14b7f 100644
--- a/crates/path-cli/src/lib.rs
+++ b/crates/path-cli/src/lib.rs
@@ -34,7 +34,7 @@ mod config;
 mod derive;
 #[cfg(not(target_os = "emscripten"))]
 mod fuzzy;
-#[cfg(not(target_os = "emscripten"))]
+#[cfg(all(not(target_os = "emscripten"), feature = "goldens"))]
 pub mod goldens;
 #[cfg(not(target_os = "emscripten"))]
 pub mod harness;
@@ -138,7 +138,7 @@ enum Commands {
         command: cmd_p::PCommand,
     },
     /// Capture, check and diff hermetic goldens for cross-harness transformations
-    #[cfg(not(target_os = "emscripten"))]
+    #[cfg(all(not(target_os = "emscripten"), feature = "goldens"))]
     Goldens {
         #[command(flatten)]
         args: goldens::GoldensArgs,
@@ -178,8 +178,19 @@ pub fn run() -> Result<()> {
         Commands::Auth { op } => cmd_auth::run(op),
         #[cfg(not(target_os = "emscripten"))]
         Commands::Config { op } => cmd_config::run(op),
-        #[cfg(not(target_os = "emscripten"))]
+        #[cfg(all(not(target_os = "emscripten"), feature = "goldens"))]
         Commands::Goldens { args } => goldens::run(args),
         Commands::P { command } => cmd_p::run(command, cli.pretty, &config),
     }
 }
+
+#[cfg(test)]
+mod tests {
+    use clap::CommandFactory;
+
+    #[test]
+    fn goldens_subcommand_only_with_the_goldens_feature() {
+        let has = super::Cli::command().find_subcommand("goldens").is_some();
+        assert_eq!(has, cfg!(feature = "goldens"));
+    }
+}
