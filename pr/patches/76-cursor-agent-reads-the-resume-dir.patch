index 17c27c9b..5ccfca5a 100644
--- a/crates/toolpath-goldens/src/pipeline.rs
+++ b/crates/toolpath-goldens/src/pipeline.rs
@@ -440,6 +440,29 @@ fn resume_dir(path: &Document) -> String {
         .to_owned()
 }
 
+/// [`resume_dir`] for a document still in JSON form.
+fn value_cwd(document: &Value) -> String {
+    document
+        .pointer("/paths/0/path/base/uri")
+        .and_then(Value::as_str)
+        .and_then(|u| u.strip_prefix("file://"))
+        .filter(|d| d.starts_with('/'))
+        .unwrap_or(CALLER_CWD)
+        .to_owned()
+}
+
+/// [`read`], then tell a reader whose format keeps no working directory where the session was
+/// resumed. A cursor-agent store holds only md5(cwd) in its path, so a reader handed the bare
+/// store cannot make file keys relative; the caller, who chose the directory (`path resume -C`),
+/// says it. Other formats record their own and are read as they are.
+fn read_in(agent: Agent, input: &[u8], scratch: &Path, cwd: &str) -> Result<Conversation, String> {
+    let mut convo = read(agent, input, scratch)?;
+    if let Conversation::CursorAgent(v) = &mut convo {
+        v.base.get_or_insert_with(Default::default).working_dir = Some(cwd.to_owned());
+    }
