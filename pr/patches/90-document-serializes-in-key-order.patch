diff --git a/crates/toolpath-goldens/tests/share_body.rs b/crates/toolpath-goldens/tests/share_body.rs
new file mode 100644
index 00000000..cad0d7ab
--- /dev/null
+++ b/crates/toolpath-goldens/tests/share_body.rs
@@ -0,0 +1,59 @@
+//! What `path share` uploads is the derived document itself (pr/89): `run_pathbase_inner`
+//! (crates/path-cli/src/cmd_export.rs) validates `body` with `Graph::from_json` and sends the
+//! same `body`. So the share cells that lose a value lose it in Pathbase's reader, not on the way
+//! up. This pins the toolpath side: for every committed document, the body `Graph::to_json`
+//! writes is the same bytes however many times it is read and written again, and it is the
+//! document (same value) the snapshot holds. The cache fast path and a fresh derive upload
+//! "byte for byte" the same text only if this holds.
+
+use std::path::PathBuf;
+
+use serde_json::Value;
+use toolpath::v1::Graph;
+
+fn snapshots() -> PathBuf {
+    PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("snapshots")
+}
+
+#[test]
+fn the_upload_body_is_the_derived_document_byte_for_byte() {
+    let mut checked = 0;
+    for entry in std::fs::read_dir(snapshots()).expect("snapshots") {
+        let path = entry.expect("entry").path();
+        let name = path.file_name().unwrap().to_string_lossy().into_owned();
+        let Some(set) = name
+            .strip_prefix("document@")
+            .and_then(|r| r.strip_suffix(".snap"))
+        else {
+            continue;
+        };
+        let text = std::fs::read_to_string(&path).unwrap();
+        let body_json = text.splitn(3, "---\n").nth(2).expect("snapshot body");
+        let graph = Graph::from_json(body_json).unwrap_or_else(|e| panic!("{set}: {e}"));
+
+        // the body `path share` builds from a freshly derived document
+        let body = graph.to_json().unwrap_or_else(|e| panic!("{set}: {e}"));
+        // validation reads it back; sending is of `body` itself, so it must survive the read
+        let again = Graph::from_json(&body)
+            .unwrap_or_else(|e| panic!("{set}: body is not a document: {e}"))
+            .to_json()
+            .unwrap();
+        assert_eq!(
+            body, again,
+            "{set}: the body changes when it is read and written again"
+        );
+
+        // and nothing was added or removed on the way: same value as the committed document
+        let sent: Value = serde_json::from_str(&body).unwrap();
+        let derived: Value = serde_json::from_str(body_json).unwrap();
+        assert_eq!(
+            sent, derived,
+            "{set}: the upload body differs from the derived document"
+        );
+        checked += 1;
+    }
+    assert!(
+        checked >= 13,
+        "expected a document per recording, found {checked}"
+    );
+}
diff --git a/crates/toolpath/src/types.rs b/crates/toolpath/src/types.rs
index fc3b15db..37b4cd63 100644
--- a/crates/toolpath/src/types.rs
+++ b/crates/toolpath/src/types.rs
@@ -1,5 +1,29 @@
 use serde::{Deserialize, Serialize};
-use std::collections::HashMap;
+use std::collections::{BTreeMap, HashMap};
+
+/// Serialize a map with its keys in order. A `HashMap` writes them in a different order on every
+/// run, so the same document would otherwise serialize to different bytes each time (the upload
+/// body, the cache file, a diff); the ordered form is the same text every time.
+fn sorted_map<S, V>(map: &HashMap<String, V>, s: S) -> Result<S::Ok, S::Error>
+where
+    S: serde::Serializer,
+    V: serde::Serialize,
+{
+    use serde::Serialize;
+    map.iter().collect::<BTreeMap<_, _>>().serialize(s)
+}
+
+/// [`sorted_map`] for an optional map.
+fn sorted_opt_map<S, V>(map: &Option<HashMap<String, V>>, s: S) -> Result<S::Ok, S::Error>
+where
+    S: serde::Serializer,
+    V: serde::Serialize,
+{
+    match map {
+        Some(m) => sorted_map(m, s),
+        None => s.serialize_none(),
+    }
+}
 
 // ============================================================================
 // Graph — the root of every Toolpath document
@@ -50,12 +74,16 @@ pub struct GraphMeta {
     pub description: Option<String>,
     #[serde(default, skip_serializing_if = "Vec::is_empty")]
     pub refs: Vec<Ref>,
-    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[serde(
+        default,
+        skip_serializing_if = "Option::is_none",
+        serialize_with = "sorted_opt_map"
+    )]
     pub actors: Option<HashMap<String, ActorDefinition>>,
     #[serde(default, skip_serializing_if = "Vec::is_empty")]
     pub signatures: Vec<Signature>,
     /// Additional properties (schema: `additionalProperties: true`)
-    #[serde(flatten)]
+    #[serde(flatten, serialize_with = "sorted_map")]
     pub extra: HashMap<String, serde_json::Value>,
 }
 
@@ -179,12 +207,16 @@ pub struct PathMeta {
     pub description: Option<String>,
     #[serde(default, skip_serializing_if = "Vec::is_empty")]
     pub refs: Vec<Ref>,
-    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[serde(
+        default,
+        skip_serializing_if = "Option::is_none",
+        serialize_with = "sorted_opt_map"
+    )]
     pub actors: Option<HashMap<String, ActorDefinition>>,
     #[serde(default, skip_serializing_if = "Vec::is_empty")]
     pub signatures: Vec<Signature>,
     /// Additional properties (schema: `additionalProperties: true`)
-    #[serde(flatten)]
+    #[serde(flatten, serialize_with = "sorted_map")]
     pub extra: HashMap<String, serde_json::Value>,
 }
 
@@ -231,6 +263,7 @@ pub struct PathMeta {
 #[derive(Debug, Clone, Serialize, Deserialize)]
 pub struct Step {
     pub step: StepIdentity,
+    #[serde(serialize_with = "sorted_map")]
     pub change: HashMap<String, ArtifactChange>,
     #[serde(default, skip_serializing_if = "Option::is_none")]
     pub meta: Option<StepMeta>,
@@ -279,7 +312,7 @@ pub struct ArtifactChange {
 pub struct StructuralChange {
     #[serde(rename = "type")]
     pub change_type: String,
-    #[serde(flatten)]
+    #[serde(flatten, serialize_with = "sorted_map")]
     pub extra: HashMap<String, serde_json::Value>,
 }
 
@@ -294,12 +327,16 @@ pub struct StepMeta {
     pub source: Option<VcsSource>,
     #[serde(default, skip_serializing_if = "Vec::is_empty")]
     pub refs: Vec<Ref>,
-    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[serde(
+        default,
+        skip_serializing_if = "Option::is_none",
+        serialize_with = "sorted_opt_map"
+    )]
     pub actors: Option<HashMap<String, ActorDefinition>>,
     #[serde(default, skip_serializing_if = "Vec::is_empty")]
     pub signatures: Vec<Signature>,
     /// Additional properties (schema: `additionalProperties: true`)
-    #[serde(flatten)]
+    #[serde(flatten, serialize_with = "sorted_map")]
     pub extra: HashMap<String, serde_json::Value>,
 }
 
@@ -312,7 +349,7 @@ pub struct VcsSource {
     #[serde(default, skip_serializing_if = "Option::is_none")]
     pub change_id: Option<String>,
     /// Additional properties (schema: `additionalProperties: true`)
-    #[serde(flatten)]
+    #[serde(flatten, serialize_with = "sorted_map")]
     pub extra: HashMap<String, serde_json::Value>,
