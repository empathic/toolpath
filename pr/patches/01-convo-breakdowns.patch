From 33fef50478e04908d67893e9e7de386cb5d0fed0 Mon Sep 17 00:00:00 2001
From: Robert DeLanghe <1240090+bdelanghe@users.noreply.github.com>
Date: Wed, 14 Oct 2026 23:48:18 -0400
Subject: [PATCH] docs(convo): a session total's breakdowns are the per-turn
 breakdowns summed class by class

---
 crates/toolpath-convo/src/lib.rs | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/crates/toolpath-convo/src/lib.rs b/crates/toolpath-convo/src/lib.rs
index 592103f..80bf24d 100644
--- a/crates/toolpath-convo/src/lib.rs
+++ b/crates/toolpath-convo/src/lib.rs
@@ -72,6 +72,8 @@ pub struct TokenUsage {
     /// {"reasoning": 450} or {"text": 300, "image": 500}). INFORMATIONAL ONLY:
     /// breakdowns are never summed into the total — the parent class already
     /// counts these tokens. Invariant: Σ(inner) ≤ the parent class's value.
+    /// (A session total's breakdowns are the per-turn breakdowns added together,
+    /// class by class; that is a sum of breakdowns, not into the counters.)
     #[serde(default, skip_serializing_if = "BTreeMap::is_empty")]
     pub breakdowns: BTreeMap<String, BTreeMap<String, u32>>,
 }
-- 
2.55.0

