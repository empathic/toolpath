+/// Cursor 3.24 model history: each message is an AI SDK `ModelMessage`
+/// stored as JSON under `agentKv:blob:<sha256>`, and `conversationState`
+/// is `"~"` + base64 of a protobuf whose field 1 repeats the 32-byte
+/// hashes in order. Observed in Cursor 3.24.12 (docs/agents/formats/cursor.md).
+fn model_history(view: &ConversationView) -> (String, HashMap<String, String>) {
+    let mut blobs: HashMap<String, String> = HashMap::new();
+    let mut order: Vec<[u8; 32]> = Vec::new();
+    let mut push = |msg: Value| {
+        let body = msg.to_string();
+        let digest: [u8; 32] = Sha256::digest(body.as_bytes()).into();
+        blobs.insert(hex_lower(&digest), body);
+        order.push(digest);
+    };
+    for turn in &view.turns {
+        match turn.role {
+            Role::User => {
+                if !turn.text.is_empty() {
+                    push(json!({"role": "user", "content": [{"type": "text", "text": turn.text}]}));
+                }
+            }
+            Role::Assistant => {
+                let mut parts: Vec<Value> = Vec::new();
+                if let Some(t) = turn.thinking.as_ref().filter(|t| !t.is_empty()) {
+                    parts.push(json!({"type": "reasoning", "text": t}));
+                }
+                if !turn.text.is_empty() {
+                    parts.push(json!({"type": "text", "text": turn.text}));
+                }
+                for tu in &turn.tool_uses {
+                    parts.push(json!({
+                        "type": "tool-call",
+                        "toolCallId": tu.id,
+                        "toolName": tu.name,
+                        "args": tu.input,
+                    }));
+                }
+                if !parts.is_empty() {
+                    push(json!({"role": "assistant", "id": turn.id, "content": parts}));
+                }
+                for tu in &turn.tool_uses {
+                    if let Some(r) = &tu.result {
+                        push(json!({
+                            "role": "tool",
+                            "content": [{
+                                "type": "tool-result",
+                                "toolCallId": tu.id,
+                                "toolName": tu.name,
+                                "result": r.content,
+                                "isError": r.is_error,
+                            }],
+                        }));
+                    }
+                }
+            }
+            Role::System | Role::Other(_) => {}
+        }
+    }
+    let mut proto: Vec<u8> = Vec::with_capacity(order.len() * 34);
+    for h in &order {
+        proto.push(0x0a); // field 1, length-delimited
+        proto.push(32);
+        proto.extend_from_slice(h);
+    }
+    (format!("~{}", base64_std(&proto)), blobs)
+}
+
+fn hex_lower(bytes: &[u8]) -> String {
+    bytes.iter().map(|b| format!("{b:02x}")).collect()
+}
+
+fn base64_std(bytes: &[u8]) -> String {
+    const A: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    let mut out = String::with_capacity(bytes.len().div_ceil(3) * 4);
+    for chunk in bytes.chunks(3) {
+        let n = (chunk[0] as u32) << 16
+            | (*chunk.get(1).unwrap_or(&0) as u32) << 8
+            | *chunk.get(2).unwrap_or(&0) as u32;
+        out.push(A[(n >> 18) as usize & 63] as char);
+        out.push(A[(n >> 12) as usize & 63] as char);
+        out.push(if chunk.len() > 1 {
+            A[(n >> 6) as usize & 63] as char
+        } else {
+            '='
+        });
+        out.push(if chunk.len() > 2 {
+            A[n as usize & 63] as char
+        } else {
+            '='
+        });
+    }
+    out
+}
