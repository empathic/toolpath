+                    .get("reasoning")
+            })
+            .sum();
+        let total = view.total_usage.as_ref().unwrap();
+        assert_eq!(total.breakdowns["output"]["reasoning"], 10);
+        assert_eq!(total.breakdowns["output"]["reasoning"], per_turn);
+    }
