From: Robert DeLanghe <1240090+bdelanghe@users.noreply.github.com>
Date: Tue, 20 Oct 2026 13:55:46 -0400
Subject: [PATCH] fix(codex): the written session's model_provider is the
 view's, else openai (pr/66)

The module doc already said so; the code hard-coded openai. pi on ollama now
projects to codex as ollama. One snapshot re-recorded; goldens/pi/to-codex.jsonl
needs capture in the nix dev shell.
---
 crates/toolpath-codex/src/project.rs          | 15 ++++++++++--
 .../snapshots/projection@pi@codex.snap        |  4 ++--
 pr/66-codex-model-provider-from-the-view.md   | 24 +++++++++++++++++++
 3 files changed, 39 insertions(+), 4 deletions(-)
 create mode 100644 pr/66-codex-model-provider-from-the-view.md

diff --git a/crates/toolpath-codex/src/project.rs b/crates/toolpath-codex/src/project.rs
index c6bb1c6f..814ea2f3 100644
--- a/crates/toolpath-codex/src/project.rs
+++ b/crates/toolpath-codex/src/project.rs
@@ -37,12 +37,16 @@ use crate::types::{
 /// carry them, as `(key, value)` in the written rollout. The baseline checks
 /// each is really written, and that a round trip gains nothing else
 /// (`crates/toolpath-goldens/fixtures/contract/codex.json`).
+/// `model_provider` is only invented when no turn of the view names a provider.
 pub const SYNTHESIZED: &[(&str, &str)] = &[
     ("originator", "codex-toolpath"),
     ("cli_version", "0.0.0-projected"),
-    ("model_provider", "openai"),
+    ("model_provider", DEFAULT_MODEL_PROVIDER),
 ];
 
+/// The `model_provider` Codex itself writes for OpenAI-served sessions.
+const DEFAULT_MODEL_PROVIDER: &str = "openai";
+
 /// Project a [`ConversationView`] into a Codex [`crate::types::Session`].
 ///
 /// Config fields are optional. Defaults match what Codex itself would
@@ -243,7 +247,14 @@ fn make_session_meta_line(
         agent_nickname: None,
         agent_role: None,
         agent_path: None,
-        model_provider: Some("openai".to_string()),
+        // Who served the session's model, when the view says (the first turn that names one);
+        // else the default Codex itself writes.
+        model_provider: Some(
+            view.turns
+                .iter()
+                .find_map(|t| t.provider.clone().filter(|p| !p.is_empty()))
+                .unwrap_or_else(|| DEFAULT_MODEL_PROVIDER.to_string()),
+        ),
         base_instructions: None,
         dynamic_tools: None,
         memory_mode: None,
diff --git a/crates/toolpath-goldens/snapshots/projection@pi@codex.snap b/crates/toolpath-goldens/snapshots/projection@pi@codex.snap
index 50526c6b..1f378723 100644
