diff --git a/crates/toolpath-goldens/src/model.rs b/crates/toolpath-goldens/src/model.rs
index 9ab778fa..9aa7d1cb 100644
--- a/crates/toolpath-goldens/src/model.rs
+++ b/crates/toolpath-goldens/src/model.rs
@@ -169,9 +169,11 @@ impl Set {
     }
 
     /// `test-fixtures/<agent>/convo.*` or `goldens/<name>/input.*`: the set
-    /// is named after its directory.
+    /// is named after its directory. `test-fixtures/<agent>/convo-compacted.*`
+    /// (a compaction forced in the agent, recorded by Ben Barber's capture script
+    /// for empathic/toolpath#108) is the set `<agent>-forced`.
     pub fn from_input_file(path: &Path) -> Result<Set, String> {
-        let name = path
+        let dir = path
             .parent()
             .and_then(Path::file_name)
             .and_then(|n| n.to_str())
@@ -181,6 +183,15 @@ impl Set {
                     path.display()
                 )
             })?;
+        let forced = path
+            .file_stem()
+            .and_then(|s| s.to_str())
+            .is_some_and(|s| s == "convo-compacted");
+        let name = if forced {
+            format!("{dir}-forced")
+        } else {
+            dir.to_owned()
+        };
         let input = std::fs::read(path).map_err(|e| format!("{}: {e}", path.display()))?;
         Set::new(name, input)
     }
