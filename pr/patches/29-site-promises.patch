index 00000000..8367a59d
--- /dev/null
+++ b/crates/toolpath-goldens/tests/formats.rs
@@ -0,0 +1,225 @@
+//! Both file formats, `.path.json` (the canonical Graph) and `.path.jsonl`
+//! (a stream that seals to a single-path Graph), on every golden document.
+//!
+//! The RFC's promise: a `.path.jsonl` stream encodes exactly one inline Path
+//! and seals to a single-path Graph at the file boundary, and a multi-path
+//! Graph or a `$ref` entry has no JSONL form. Each golden's pinned
+//! `document@<set>` is streamed to JSONL, sealed back, and compared with the
+//! original in canonical form (keys sorted, no whitespace); `formats@<set>`
+//! pins the stream's shape and the result. The committed `examples/*.path.jsonl`
+//! are checked against their `.path.json` twins the same way, and the two
+//! refusals are asserted.
+
+use std::path::{Path, PathBuf};
+
+use serde_json::{Value, json};
+use toolpath::v1::Graph;
+
+const SNAPSHOTS: &str = concat!(env!("CARGO_MANIFEST_DIR"), "/snapshots");
+const EXAMPLES: &str = concat!(env!("CARGO_MANIFEST_DIR"), "/../../examples");
+
+/// Keys sorted at every level, then compact: the comparison form.
+fn canonical(v: &Value) -> Value {
+    match v {
+        Value::Object(m) => {
+            let mut keys: Vec<&String> = m.keys().collect();
+            keys.sort();
+            let mut out = serde_json::Map::new();
+            for k in keys {
+                out.insert(k.clone(), canonical(&m[k]));
+            }
+            Value::Object(out)
+        }
+        Value::Array(a) => Value::Array(a.iter().map(canonical).collect()),
+        other => other.clone(),
+    }
+}
+
+fn canonical_bytes(g: &Graph) -> Vec<u8> {
+    let v = serde_json::to_value(g).expect("graph serializes");
+    serde_json::to_vec(&canonical(&v)).expect("value serializes")
+}
+
+/// Key paths whose values differ between `a` and `b` (array indices collapsed to `[]`).
+fn differing(a: &Value, b: &Value, at: &str, out: &mut std::collections::BTreeSet<String>) {
+    match (a, b) {
+        (Value::Object(x), Value::Object(y)) => {
+            for k in x.keys().chain(y.keys()) {
+                let p = if at.is_empty() {
+                    k.clone()
+                } else {
+                    format!("{at}.{k}")
+                };
+                match (x.get(k), y.get(k)) {
+                    (Some(l), Some(r)) => differing(l, r, &p, out),
+                    _ => {
+                        out.insert(p);
+                    }
+                }
+            }
+        }
+        (Value::Array(x), Value::Array(y)) if x.len() == y.len() => {
+            for (l, r) in x.iter().zip(y) {
+                differing(l, r, &format!("{at}[]"), out);
+            }
+        }
+        _ if a == b => {}
+        _ => {
+            out.insert(at.to_string());
+        }
+    }
+}
+
+/// The body of an insta snapshot: everything after the second `---` line.
+fn snapshot_body(path: &Path) -> String {
+    let text = std::fs::read_to_string(path).expect("read snapshot");
+    let mut parts = text.splitn(3, "---\n");
+    parts.next();
+    parts.next();
+    parts.next().expect("snapshot has a body").to_string()
+}
+
+fn document_snapshots() -> Vec<(String, PathBuf)> {
+    let mut out: Vec<(String, PathBuf)> = std::fs::read_dir(SNAPSHOTS)
+        .expect("read snapshots dir")
+        .filter_map(|e| e.ok().map(|e| e.path()))
+        .filter_map(|p| {
+            let name = p.file_name()?.to_str()?.to_string();
+            let set = name.strip_prefix("document@")?.strip_suffix(".snap")?;
+            Some((set.to_string(), p))
+        })
+        .collect();
+    out.sort();
+    out
+}
+
+/// Stream `g` to JSONL, seal it back, compare in canonical form.
+fn stream_and_seal(g: &Graph) -> Value {
+    let jsonl = g
+        .to_jsonl_string()
+        .expect("a single-path graph has a JSONL form");
+    let sealed = Graph::from_jsonl_str(&jsonl).expect("our own JSONL reads back");
+    let mut tags: std::collections::BTreeMap<String, usize> = Default::default();
+    for line in jsonl.lines() {
+        let v: Value = serde_json::from_str(line).expect("each JSONL line is JSON");
+        let tag = v
+            .as_object()
+            .and_then(|m| m.keys().next().cloned())
+            .unwrap_or_default();
+        *tags.entry(tag).or_default() += 1;
+    }
+    let (a, b) = (canonical_bytes(g), canonical_bytes(&sealed));
+    let mut diff = std::collections::BTreeSet::new();
+    if a != b {
+        differing(
+            &serde_json::to_value(g).unwrap(),
+            &serde_json::to_value(&sealed).unwrap(),
+            "",
+            &mut diff,
+        );
+    }
+    json!({
+        "jsonl_lines": jsonl.lines().count(),
+        "lines_by_tag": tags,
+        "sealed_equals_json": a == b,
+        "differing_key_paths": diff,
+    })
+}
+
+#[test]
+fn every_golden_document_streams_to_jsonl_and_seals_back_unchanged() {
+    let docs = document_snapshots();
+    assert_eq!(docs.len(), 9, "one document@<set> per golden set");
+    let mut settings = insta::Settings::clone_current();
+    settings.set_snapshot_path("../snapshots");
+    settings.set_prepend_module_to_snapshot(false);
+    settings.set_sort_maps(true);
+    let mut unequal = Vec::new();
+    settings.bind(|| {
+        for (set, path) in &docs {
+            let g = Graph::from_json(&snapshot_body(path))
+                .unwrap_or_else(|e| panic!("document@{set} is a Graph: {e}"));
+            let result = stream_and_seal(&g);
+            if result["sealed_equals_json"] != json!(true) {
+                unequal.push(format!("{set}: {}", result["differing_key_paths"]));
+            }
+            insta::assert_json_snapshot!(format!("formats@{set}"), result);
+        }
+    });
+    assert!(
+        unequal.is_empty(),
+        "sealed .path.jsonl differs from .path.json:\n{}",
+        unequal.join("\n")
+    );
+}
+
+/// The committed `examples/*.path.jsonl` against their `.path.json` twins.
+///
+/// A stream carries no graph identity: sealing names the graph after its
+/// path (`Graph::from_path`), while the committed twins name it
+/// `graph-<path id>`. Everything else must match; the graph-id difference is
+/// pinned in `formats@examples` rather than hidden.
+#[test]
+fn committed_jsonl_examples_seal_to_their_json_twins() {
+    let mut entries: Vec<PathBuf> = std::fs::read_dir(EXAMPLES)
+        .expect("read examples")
+        .filter_map(|e| e.ok().map(|e| e.path()))
+        .filter(|p| p.to_string_lossy().ends_with(".path.jsonl"))
+        .collect();
+    entries.sort();
+    let mut rows = Vec::new();
+    for jsonl in &entries {
+        let twin = PathBuf::from(jsonl.to_string_lossy().replace(".path.jsonl", ".path.json"));
+        let sealed = Graph::from_jsonl_str(&std::fs::read_to_string(jsonl).unwrap())
+            .unwrap_or_else(|e| panic!("{}: {e}", jsonl.display()));
+        let json = Graph::from_json(&std::fs::read_to_string(&twin).unwrap())
+            .unwrap_or_else(|e| panic!("{}: {e}", twin.display()));
+        let mut diff = std::collections::BTreeSet::new();
+        differing(
+            &serde_json::to_value(&json).unwrap(),
+            &serde_json::to_value(&sealed).unwrap(),
+            "",
+            &mut diff,
+        );
+        let name = jsonl.file_name().unwrap().to_string_lossy().into_owned();
+        assert!(
+            diff.iter().all(|p| p == "graph.id"),
+            "{name} differs from its .path.json twin beyond graph.id: {diff:?}"
+        );
+        rows.push(json!({
+            "example": name,
+            "differs_only_in": diff,
+            "json_graph_id": json.graph.id,
+            "sealed_graph_id": sealed.graph.id,
+        }));
+    }
+    assert!(rows.len() >= 4, "the four path-0N examples have both forms");
+    let mut settings = insta::Settings::clone_current();
+    settings.set_snapshot_path("../snapshots");
+    settings.set_prepend_module_to_snapshot(false);
+    settings.bind(|| insta::assert_json_snapshot!("formats@examples", rows));
+}
+
+#[test]
+fn a_multi_path_graph_has_no_jsonl_form() {
+    let release = std::fs::read_to_string(format!("{EXAMPLES}/graph-01-release.json")).unwrap();
+    let g = Graph::from_json(&release).expect("graph-01-release parses");
+    assert!(g.paths.len() > 1, "the release example holds several paths");
+    let err = g
+        .to_jsonl_string()
+        .expect_err("multi-path graphs cannot stream");
+    assert!(
+        err.to_string().to_lowercase().contains("path"),
+        "the refusal names the reason: {err}"
+    );
+}
+
+#[test]
+fn a_ref_only_graph_has_no_jsonl_form() {
+    let g = Graph::from_json(
+        r#"{"graph":{"id":"g-ref"},"paths":[{"$ref":"https://example.com/toolpath/path-44.path.json"}]}"#,
+    )
+    .expect("a $ref-only graph parses");
+    g.to_jsonl_string()
+        .expect_err("a $ref entry has no inline Path to stream");
+}
diff --git a/crates/toolpath-goldens/tests/transforms_schema.rs b/crates/toolpath-goldens/tests/transforms_schema.rs
new file mode 100644
index 00000000..2316eefa
--- /dev/null
+++ b/crates/toolpath-goldens/tests/transforms_schema.rs
@@ -0,0 +1,207 @@
+//! A schema check on every transform: each document a transform produces is
+//! validated against the base schema and the `agent-coding-session` v1.1.0
+//! kind schema (the bundled `crates/path-cli/kinds/agent-coding-session/
+//! v1.1.0/schema.json`, which is what toolpath.net publishes: see
+//! `bundled_kind_schema_is_the_published_one`).
+//!
+//! Transforms covered, per golden set (`validate_transforms@<set>`):
+//! * `document`: the derived document (the pinned `document@<set>`);
+//! * `round_trips.<agent>`: that document projected for each other agent,
+//!   read back by that agent's adapter and derived again (the 54 pairs);
+//! * `jsonl_sealed`: the document streamed to `.path.jsonl` and sealed back.
+//!
+//! And `validate_transforms@writers`: the generated full document through
+//! each writer alone, derived again.
+//!
+//! Each entry records the outcome and the `meta.kind` of every path. A path
+//! with no kind would skip the kind schema silently, so a document that
+//! claims no kind fails here by name, as does any schema error.
+
+use std::path::Path;
+
+use serde_json::{Value, json};
+use toolpath::v1::Graph;
+use toolpath_convo::{ConversationView, DeriveConfig, derive_path};
+use toolpath_goldens::model::{Agent, Validation};
+use toolpath_goldens::pipeline::writer_with_document;
+use toolpath_goldens::validate::validate;
+
+const SNAPSHOTS: &str = concat!(env!("CARGO_MANIFEST_DIR"), "/snapshots");
+const KIND: &str = toolpath::v1::PATH_KIND_AGENT_CODING_SESSION;
+const VIEW: &str = include_str!("../fixtures/full-view.json");
+
+fn snapshot(path: &Path) -> (String, String) {
+    let text = std::fs::read_to_string(path).unwrap();
+    let mut parts = text.splitn(3, "---\n");
+    parts.next();
+    let header = parts.next().unwrap().to_string();
+    (header, parts.next().unwrap().to_string())
+}
+
+fn kinds(doc: &Value) -> Vec<Value> {
+    doc["paths"]
+        .as_array()
+        .map(|ps| {
+            ps.iter()
+                .map(|p| p.pointer("/meta/kind").cloned().unwrap_or(Value::Null))
+                .collect()
+        })
+        .unwrap_or_default()
+}
+
+/// Outcome of one transform: schema result plus the kinds its paths claim.
+fn check(doc: Option<&Value>, failures: &mut Vec<String>, label: &str) -> Value {
+    let Some(doc) = doc else {
+        return json!({ "outcome": "not_derived" });
+    };
+    let ks = kinds(doc);
+    if ks.iter().any(|k| k.as_str() != Some(KIND)) {
+        failures.push(format!(
+            "{label}: a path does not claim {KIND} (kinds {ks:?})"
+        ));
+    }
+    match validate(doc) {
+        Validation::Valid => json!({ "outcome": "valid", "kinds": ks }),
+        Validation::Invalid { errors } => {
+            failures.push(format!("{label}: {}", errors.join("; ")));
+            json!({ "outcome": "invalid", "kinds": ks, "errors": errors })
+        }
+        Validation::NotDerived => json!({ "outcome": "not_derived" }),
+    }
+}
+
+fn agent_named(name: &str) -> Agent {
+    *Agent::ALL
+        .iter()
+        .find(|a| a.name() == name)
+        .expect("known agent")
+}
+
+fn point_every_store_at(home: &Path) {
+    let vars = [
+        ("HOME", home.to_path_buf()),
+        ("TMPDIR", home.to_path_buf()),
+        ("XDG_CONFIG_HOME", home.join(".config")),
+        ("XDG_DATA_HOME", home.join(".local/share")),
+        ("XDG_STATE_HOME", home.join(".local/state")),
+        ("XDG_CACHE_HOME", home.join(".cache")),
+        ("CLAUDE_CONFIG_DIR", home.join(".claude")),
+        ("CODEX_HOME", home.join(".codex")),
+        ("COPILOT_HOME", home.join(".copilot")),
+        ("TOOLPATH_CONFIG_DIR", home.join(".toolpath")),
+    ];
+    for (k, v) in vars {
+        // SAFETY: one test in this binary, set before any adapter runs.
+        unsafe { std::env::set_var(k, v) };
+    }
+}
+
+#[test]
+fn every_transform_validates_against_the_v1_1_0_kind() {
+    let home = tempfile::tempdir().unwrap();
+    point_every_store_at(home.path());
+    let mut settings = insta::Settings::clone_current();
+    settings.set_snapshot_path("../snapshots");
+    settings.set_prepend_module_to_snapshot(false);
+    settings.set_sort_maps(true);
+
+    let mut failures = Vec::new();
+    let mut docs: Vec<(String, std::path::PathBuf)> = std::fs::read_dir(SNAPSHOTS)
+        .unwrap()
+        .filter_map(|e| e.ok().map(|e| e.path()))
+        .filter_map(|p| {
+            let n = p.file_name()?.to_str()?;
+            let set = n
+                .strip_prefix("document@")?
+                .strip_suffix(".snap")?
+                .to_string();
+            Some((set, p))
+        })
+        .collect();
+    docs.sort();
+    assert_eq!(docs.len(), 9);
+
+    settings.bind(|| {
+        for (set, path) in &docs {
+            let (header, body) = snapshot(path);
+            let agent = header
+                .lines()
+                .find_map(|l| l.trim().strip_prefix("agent: "))
+                .map(agent_named)
+                .expect("document snapshot names its agent");
+            let document: Value = serde_json::from_str(&body).unwrap();
+            let mut round_trips = serde_json::Map::new();
+            for target in agent.targets() {
+                let (_, again) = writer_with_document(&body, target, home.path())
+                    .unwrap_or_else(|e| panic!("{set} -> {}: {e}", target.name()));
+                round_trips.insert(
+                    target.name().to_string(),
+                    check(
+                        again.as_ref(),
+                        &mut failures,
+                        &format!("{set} -> {}", target.name()),
+                    ),
+                );
+            }
+            let g = Graph::from_json(&body).unwrap();
+            let sealed = Graph::from_jsonl_str(&g.to_jsonl_string().unwrap()).unwrap();
+            let sealed = serde_json::to_value(&sealed).unwrap();
+            let result = json!({
+                "document": check(Some(&document), &mut failures, &format!("{set} document")),
+                "round_trips": round_trips,
+                "jsonl_sealed": check(Some(&sealed), &mut failures, &format!("{set} jsonl")),
+            });
+            insta::assert_json_snapshot!(format!("validate_transforms@{set}"), result);
+        }
+
+        let view: ConversationView = serde_json::from_str(VIEW).unwrap();
+        let cfg = DeriveConfig {
+            include_thinking: true,
+            include_tool_uses: true,
+            ..DeriveConfig::default()
+        };
+        let document_json = Graph::from_path(derive_path(&view, &cfg))
+            .to_json()
+            .unwrap();
+        let mut writers = serde_json::Map::new();
+        for agent in Agent::ALL {
+            let (_, again) = writer_with_document(&document_json, agent, home.path())
+                .unwrap_or_else(|e| panic!("writer {}: {e}", agent.name()));
+            writers.insert(
+                agent.name().to_string(),
+                check(
+                    again.as_ref(),
+                    &mut failures,
+                    &format!("writer {}", agent.name()),
+                ),
+            );
+        }
+        insta::assert_json_snapshot!("validate_transforms@writers", Value::Object(writers));
+    });
+
+    assert!(
+        failures.is_empty(),
+        "transforms whose document the v1.1.0 kind rejects (or that claim no kind):\n{}",
+        failures.join("\n")
+    );
+}
+
+/// The bundled kind schema and the copy the site publishes
+/// (`site/kinds/agent-coding-session/v1.1.0/schema.json`, served at
+/// https://toolpath.net/kinds/agent-coding-session/v1.1.0/schema.json) are the
+/// same bytes. Checked against the live URL once by hand on 2026-10-19
+/// (sha256 0557c0c06fe285704a672ac7f86abbd78f2e6e17e44aed0abbbdcc524ad523da,
+/// identical); this keeps the two in-repo copies from drifting.
+#[test]
+fn bundled_kind_schema_is_the_published_one() {
+    let root = Path::new(env!("CARGO_MANIFEST_DIR")).join("../..");
+    let bundled =
+        std::fs::read(root.join("crates/path-cli/kinds/agent-coding-session/v1.1.0/schema.json"))
+            .unwrap();
+    let site =
+        std::fs::read(root.join("site/kinds/agent-coding-session/v1.1.0/schema.json")).unwrap();
+    assert!(
+        bundled == site,
+        "the bundled v1.1.0 kind schema differs from the site's copy"
+    );
+}
