@@ -0,0 +1,85 @@
+//! `toolpath-agents list|fetch|path|run`: the agent CLIs the tests run, through `agents.lock` only.
+
+use std::path::PathBuf;
+
+use anyhow::{Context, Result};
+use clap::{Parser, Subcommand};
+use toolpath_agents::{Cache, Hermetic, Lock, host_target};
+
+#[derive(Parser, Debug)]
+#[command(
+    name = "toolpath-agents",
+    about = "Hash-verified agent CLIs for toolpath's tests"
+)]
+struct Cli {
+    /// The lock file
+    #[arg(long, global = true, default_value = "agents.lock")]
+    lock: PathBuf,
+    /// Rust target triple (default: this machine)
+    #[arg(long, global = true)]
+    target: Option<String>,
+    #[command(subcommand)]
+    command: Cmd,
+}
+
+#[derive(Subcommand, Debug)]
+enum Cmd {
+    /// What the lock names and whether each entry is fetched
+    List,
+    /// Download an agent from the lock's url, verify its sha256, unpack it; prints the executable
+    Fetch { agent: String },
+    /// The installed executable of an already fetched agent
+    Path { agent: String },
+    /// Run a fetched agent hermetically (empty env, temp HOME, cwd /), passing ARGS
+    Run {
+        agent: String,
+        #[arg(trailing_var_arg = true, allow_hyphen_values = true)]
+        args: Vec<String>,
+    },
+}
+
+fn main() -> Result<()> {
+    let cli = Cli::parse();
+    let lock = Lock::parse(
+        &std::fs::read_to_string(&cli.lock)
+            .with_context(|| format!("read {}", cli.lock.display()))?,
+    )?;
+    let cache = Cache::default_location()?;
+    let target = cli.target.unwrap_or_else(|| host_target().to_string());
+    match cli.command {
+        Cmd::List => {
+            for a in &lock.agents {
+                for p in &a.platforms {
+                    let state = if cache.lookup(&p.sha256).is_some() {
+                        "fetched"
+                    } else {
+                        "not fetched"
+                    };
+                    println!(
+                        "{} {} {} {} {state}",
+                        a.name,
+                        a.version,
+                        p.target,
+                        &p.sha256[..12]
+                    );
+                }
+            }
+        }
+        Cmd::Fetch { agent } => {
+            let (_, p) = lock.find(&agent, &target)?;
+            cache.fetch(p)?;
+            println!("{}", cache.install(p)?.display());
+        }
+        Cmd::Path { agent } => {
+            let (_, p) = lock.find(&agent, &target)?;
+            println!("{}", cache.install(p)?.display());
+        }
+        Cmd::Run { agent, args } => {
+            let (_, p) = lock.find(&agent, &target)?;
+            let h = Hermetic::new(cache.install(p)?)?;
+            let status = h.command(&args).status()?;
+            std::process::exit(status.code().unwrap_or(1));
+        }
+    }
+    Ok(())
+}
diff --git a/crates/toolpath-agents/src/cache.rs b/crates/toolpath-agents/src/cache.rs
new file mode 100644
index 00000000..e3ca45a3
--- /dev/null
+++ b/crates/toolpath-agents/src/cache.rs
@@ -0,0 +1,222 @@
+//! A content-addressed cache of verified agent downloads and their unpacked executables.
+
+use std::path::{Path, PathBuf};
+
+use anyhow::{Context, Result, anyhow, bail};
+use sha2::{Digest, Sha256};
+
+use crate::lock::{Archive, Platform};
+
+pub fn sha256_hex(bytes: &[u8]) -> String {
+    Sha256::digest(bytes)
+        .iter()
+        .map(|b| format!("{b:02x}"))
+        .collect()
+}
+
+pub struct Cache {
+    root: PathBuf,
+}
+
+impl Cache {
+    pub fn at(root: impl Into<PathBuf>) -> Cache {
+        Cache { root: root.into() }
+    }
+
+    /// `$XDG_CACHE_HOME/toolpath/agents`, else `$HOME/.cache/toolpath/agents`.
+    pub fn default_location() -> Result<Cache> {
+        let base = match std::env::var_os("XDG_CACHE_HOME").filter(|v| !v.is_empty()) {
+            Some(x) => PathBuf::from(x),
+            None => PathBuf::from(std::env::var_os("HOME").ok_or_else(|| anyhow!("no HOME"))?)
+                .join(".cache"),
+        };
+        Ok(Cache::at(base.join("toolpath/agents")))
+    }
+
+    fn blob(&self, sha: &str) -> PathBuf {
+        self.root.join(sha).join("blob")
+    }
+
+    fn unpacked(&self, sha: &str) -> PathBuf {
+        self.root.join(sha).join("root")
+    }
+
+    /// Keep `bytes` under their sha256, which must be `expected`; refuses otherwise. The blob has
+    /// no execute bit: only [`Cache::install`] makes something runnable.
+    pub fn store(&self, expected: &str, bytes: &[u8]) -> Result<PathBuf> {
+        let got = sha256_hex(bytes);
+        if got != expected {
+            bail!("sha256 mismatch: the lock says {expected}, the download is {got}");
+        }
+        let path = self.blob(expected);
+        std::fs::create_dir_all(path.parent().expect("has a parent"))?;
+        let tmp = path.with_extension("part");
+        std::fs::write(&tmp, bytes)?;
+        std::fs::rename(&tmp, &path)?;
+        Ok(path)
+    }
+
+    /// The cached blob for `sha`, re-hashed on every lookup: an entry that no longer matches its
+    /// name is treated as absent.
+    pub fn lookup(&self, sha: &str) -> Option<PathBuf> {
+        let p = self.blob(sha);
+        let bytes = std::fs::read(&p).ok()?;
+        (sha256_hex(&bytes) == sha).then_some(p)
+    }
+
+    /// Download `platform.url` unless a valid blob is cached, verify it, keep it.
+    pub fn fetch(&self, platform: &Platform) -> Result<PathBuf> {
+        if let Some(p) = self.lookup(&platform.sha256) {
+            return Ok(p);
+        }
+        // Agent binaries run to hundreds of MB (claude's is ~275 MB): reqwest's blocking default
+        // of 30 s for the whole body is too short, so the limit is per download, generous.
+        let client = reqwest::blocking::Client::builder()
+            .timeout(std::time::Duration::from_secs(1800))
+            .build()?;
+        let bytes = client
+            .get(&platform.url)
+            .send()
+            .and_then(|r| r.error_for_status())
+            .and_then(|r| r.bytes())
+            .with_context(|| format!("download {}", platform.url))?;
+        self.store(&platform.sha256, &bytes)
+    }
+
+    /// The executable for a fetched platform entry, unpacked once from the verified blob.
+    pub fn install(&self, platform: &Platform) -> Result<PathBuf> {
+        let blob = self.lookup(&platform.sha256).ok_or_else(|| {
+            anyhow!(
+                "{} is not in the cache (fetch it first)",
+                &platform.sha256[..12]
+            )
+        })?;
+        let root = self.unpacked(&platform.sha256);
+        let exe = match (platform.archive, &platform.member) {
+            (Archive::Binary, _) => root.join("agent"),
+            (Archive::TarGz, Some(m)) => root.join(m),
+            (Archive::TarGz, None) => bail!("a tar-gz entry must name its member"),
+        };
+        if exe.is_file() {
+            return Ok(exe);
+        }
+        let tmp = root.with_extension("part");
+        let _ = std::fs::remove_dir_all(&tmp);
+        std::fs::create_dir_all(&tmp)?;
+        match platform.archive {
+            Archive::Binary => {
+                std::fs::copy(&blob, tmp.join("agent"))?;
+            }
+            Archive::TarGz => {
+                let gz = flate2::read::GzDecoder::new(std::fs::File::open(&blob)?);
+                let mut ar = tar::Archive::new(gz);
+                ar.set_preserve_permissions(false);
+                // `unpack` refuses entries that would land outside `tmp` (`..`, absolute paths).
+                ar.unpack(&tmp)?;
+            }
+        }
+        let staged = tmp.join(exe.strip_prefix(&root).expect("under root"));
+        if !staged.is_file() {
+            bail!("{} has no member {}", platform.url, staged.display());
+        }
+        make_executable(&staged)?;
+        std::fs::rename(&tmp, &root)?;
+        Ok(exe)
+    }
+}
+
+#[cfg(unix)]
+fn make_executable(p: &Path) -> Result<()> {
+    use std::os::unix::fs::PermissionsExt;
+    std::fs::set_permissions(p, std::fs::Permissions::from_mode(0o755))?;
+    Ok(())
+}
+
+#[cfg(not(unix))]
+fn make_executable(_: &Path) -> Result<()> {
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn platform(sha: &str, archive: Archive, member: Option<&str>) -> Platform {
+        Platform {
+            target: "t".into(),
+            url: "https://example.invalid/x".into(),
+            sha256: sha.into(),
+            archive,
+            member: member.map(String::from),
+        }
+    }
+
+    #[test]
+    fn a_blob_is_kept_only_under_its_own_hash_and_a_mismatch_is_refused() {
+        let dir = tempfile::tempdir().unwrap();
+        let cache = Cache::at(dir.path());
+        let sha = sha256_hex(b"agent bytes");
+        let p = cache.store(&sha, b"agent bytes").unwrap();
+        assert_eq!(cache.lookup(&sha), Some(p.clone()));
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::PermissionsExt;
+            let mode = std::fs::metadata(&p).unwrap().permissions().mode();
+            assert_eq!(mode & 0o111, 0, "a blob is never executable");
+        }
+        let e = cache.store(&sha, b"tampered").unwrap_err().to_string();
+        assert!(e.contains("sha256 mismatch"), "{e}");
+    }
+
+    #[test]
+    fn a_corrupted_cache_entry_is_not_trusted() {
+        let dir = tempfile::tempdir().unwrap();
+        let cache = Cache::at(dir.path());
+        let sha = sha256_hex(b"good");
+        let p = cache.store(&sha, b"good").unwrap();
+        std::fs::write(&p, b"bad").unwrap();
+        assert_eq!(cache.lookup(&sha), None);
+        assert!(
+            cache
+                .install(&platform(&sha, Archive::Binary, None))
+                .is_err()
+        );
+    }
+
+    #[test]
+    fn install_unpacks_the_named_member_of_a_verified_tar_gz_and_makes_only_it_runnable() {
+        let mut tgz = Vec::new();
+        {
+            let gz = flate2::write::GzEncoder::new(&mut tgz, flate2::Compression::default());
+            let mut b = tar::Builder::new(gz);
+            let body = b"#!/bin/sh\necho hi\n";
+            let mut h = tar::Header::new_gnu();
+            h.set_size(body.len() as u64);
+            h.set_mode(0o644);
+            h.set_cksum();
+            b.append_data(&mut h, "pkg/bin/tool", &body[..]).unwrap();
+            b.into_inner().unwrap().finish().unwrap();
+        }
+        let dir = tempfile::tempdir().unwrap();
+        let cache = Cache::at(dir.path());
+        let sha = sha256_hex(&tgz);
+        cache.store(&sha, &tgz).unwrap();
+        let exe = cache
+            .install(&platform(&sha, Archive::TarGz, Some("pkg/bin/tool")))
+            .unwrap();
+        assert!(exe.ends_with("pkg/bin/tool"));
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::PermissionsExt;
+            assert_eq!(
+                std::fs::metadata(&exe).unwrap().permissions().mode() & 0o777,
+                0o755
+            );
+        }
+        let e = cache
+            .install(&platform(&sha, Archive::TarGz, Some("pkg/bin/other")))
+            .unwrap_err()
+            .to_string();
+        assert!(e.contains("has no member"), "{e}");
+    }
+}
diff --git a/crates/toolpath-agents/src/hermetic.rs b/crates/toolpath-agents/src/hermetic.rs
new file mode 100644
index 00000000..287894fb
--- /dev/null
+++ b/crates/toolpath-agents/src/hermetic.rs
@@ -0,0 +1,119 @@
+//! Run an agent so that it sees only what the caller passes in.
+//!
+//! The child gets an EMPTY environment except: `HOME` and `TMPDIR` (fresh temporary directories,
+//! removed when the [`Hermetic`] is dropped), `PATH=/usr/bin:/bin` (system tools only: never the
+//! developer's PATH, Homebrew or a version manager) and `LANG=C.UTF-8`. Its working directory is
+//! `/`. Anything else (a fixture's config, a webmock URL, a fake credential) must be added with
+//! [`Hermetic::env`] or written under [`Hermetic::home`] by the test, so the inputs of a run are
+//! exactly what the test names. Real credentials are never inherited.
+
+use std::ffi::OsStr;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+use anyhow::Result;
+
+pub const PATH: &str = "/usr/bin:/bin";
+
+pub struct Hermetic {
+    exe: PathBuf,
+    home: tempfile::TempDir,
+    tmp: tempfile::TempDir,
+    env: Vec<(String, String)>,
+}
+
+impl Hermetic {
+    /// `exe` is an installed agent (from [`crate::Cache::install`]), never a name looked up on PATH.
+    pub fn new(exe: impl Into<PathBuf>) -> Result<Hermetic> {
+        Ok(Hermetic {
+            exe: exe.into(),
+            home: tempfile::Builder::new().prefix("agent-home.").tempdir()?,
+            tmp: tempfile::Builder::new().prefix("agent-tmp.").tempdir()?,
+            env: Vec::new(),
+        })
+    }
+
+    /// The child's HOME, for the test to seed config or fixtures into before running.
+    pub fn home(&self) -> &Path {
+        self.home.path()
+    }
+
+    /// Add one variable to the child's otherwise empty environment.
+    pub fn env(mut self, key: impl Into<String>, value: impl Into<String>) -> Hermetic {
+        self.env.push((key.into(), value.into()));
+        self
+    }
+
+    /// The command, ready for args; the [`Hermetic`] must outlive the child (it owns HOME/TMPDIR).
+    pub fn command<I, S>(&self, args: I) -> Command
+    where
+        I: IntoIterator<Item = S>,
+        S: AsRef<OsStr>,
+    {
+        let mut c = Command::new(&self.exe);
+        c.args(args)
+            .env_clear()
+            .env("HOME", self.home.path())
+            .env("TMPDIR", self.tmp.path())
+            .env("PATH", PATH)
+            .env("LANG", "C.UTF-8")
+            .current_dir("/");
+        for (k, v) in &self.env {
+            c.env(k, v);
+        }
+        c
+    }
+}
+
+#[cfg(all(test, unix))]
+mod tests {
+    use super::*;
+    use std::os::unix::fs::PermissionsExt;
+
+    /// A stand-in agent that reports what it sees: its environment and working directory.
+    fn reporter(dir: &Path) -> PathBuf {
+        let p = dir.join("reporter");
+        std::fs::write(&p, "#!/bin/sh\npwd\nenv | LC_ALL=C sort\n").unwrap();
+        std::fs::set_permissions(&p, std::fs::Permissions::from_mode(0o755)).unwrap();
+        p
+    }
+
+    #[test]
+    fn the_child_sees_only_a_temp_home_system_path_and_what_the_test_adds() {
+        // The test process has HOME, PATH, CARGO_* and more; the exact key list below proves
+        // none of them reach the child.
+        let dir = tempfile::tempdir().unwrap();
+        let h = Hermetic::new(reporter(dir.path()))
+            .unwrap()
+            .env("WEBMOCK_URL", "http://127.0.0.1:1");
+        let out = h.command(Vec::<&str>::new()).output().unwrap();
+        assert!(out.status.success());
+        let text = String::from_utf8(out.stdout).unwrap();
+        let mut lines = text.lines();
+        assert_eq!(lines.next(), Some("/"), "cwd is /");
+        let keys: Vec<&str> = lines
+            .map(|l| l.split('=').next().unwrap())
+            .filter(|k| !["PWD", "SHLVL", "_", "OLDPWD"].contains(k)) // set by sh itself
+            .collect();
+        assert_eq!(
+            keys,
+            ["HOME", "LANG", "PATH", "TMPDIR", "WEBMOCK_URL"],
+            "{text}"
+        );
+        assert!(text.contains(&format!("HOME={}", h.home().display())));
+        assert!(text.contains("PATH=/usr/bin:/bin\n"));
+    }
+
+    #[test]
+    fn home_and_tmpdir_are_fresh_per_run_and_removed_afterwards() {
+        let dir = tempfile::tempdir().unwrap();
+        let exe = reporter(dir.path());
+        let a = Hermetic::new(&exe).unwrap();
+        let b = Hermetic::new(&exe).unwrap();
+        assert_ne!(a.home(), b.home());
+        let home = a.home().to_path_buf();
+        assert!(home.is_dir());
+        drop(a);
+        assert!(!home.exists());
+    }
+}
