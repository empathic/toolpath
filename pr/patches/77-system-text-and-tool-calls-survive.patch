index 2a75b7a6..53c788e0 100644
--- a/crates/toolpath-cursor/src/agent_store.rs
+++ b/crates/toolpath-cursor/src/agent_store.rs
@@ -245,6 +245,21 @@ impl AgentStore {
                     .join("\n")
             };
             match msg["role"].as_str() {
+                Some("system") => {
+                    // `content` is a string (the CLI's first blob, the writer's system turn)
+                    // or a list of text parts.
+                    let text = match &msg["content"] {
+                        Value::String(s) => s.clone(),
+                        _ => texts("text"),
+                    };
+                    turns.push(new_turn(
+                        format!("system-{i}"),
+                        Role::System,
+                        &timestamp,
+                        text,
+                        &turns,
+                    ));
+                }
                 Some("user") => {
                     let id = user_ids
                         .next()
diff --git a/crates/toolpath-cursor/src/project.rs b/crates/toolpath-cursor/src/project.rs
index b6aeeee2..615c277d 100644
--- a/crates/toolpath-cursor/src/project.rs
+++ b/crates/toolpath-cursor/src/project.rs
@@ -169,6 +169,20 @@ fn project_view(
 
         headers.push(header_for(&bubble, turn));
         bubbles.push(bubble);
+
+        // A Cursor bubble carries one tool call (`toolFormerData`): a turn's further calls
+        // each get a bubble of their own, as Cursor writes them, so none is dropped.
+        for (k, tu) in turn.tool_uses.iter().enumerate().skip(1) {
+            let mut extra = turn.clone();
+            extra.id = format!("{}-tool-{k}", turn.id);
+            extra.text = String::new();
+            extra.thinking = None;
+            extra.token_usage = None;
+            extra.tool_uses = vec![tu.clone()];
+            let bubble = build_bubble(&extra, &mut content_blobs);
+            headers.push(header_for(&bubble, &extra));
+            bubbles.push(bubble);
+        }
     }
 
     let workspace_identifier = if workspace_path_str.starts_with('/') {
@@ -869,7 +883,13 @@ pub(crate) fn model_messages(view: &ConversationView) -> ModelHistory {
                     }
                 }
             }
-            Role::System | Role::Other(_) => {}
+            // The model history keeps a system message, as the CLI's own first blob does.
+            Role::System => {
+                if !turn.text.is_empty() {
+                    push(json!({"role": "system", "content": turn.text}));
+                }
+            }
+            Role::Other(_) => {}
         }
     }
     ModelHistory { order, blobs }
diff --git a/crates/toolpath-cursor/src/provider.rs b/crates/toolpath-cursor/src/provider.rs
index b6d23d87..b00ae6ea 100644
--- a/crates/toolpath-cursor/src/provider.rs
+++ b/crates/toolpath-cursor/src/provider.rs
@@ -317,6 +317,17 @@ impl<'a> Builder<'a> {
                 // shorter conversation than break the parse.
                 _ => continue,
             };
+            // The writer gives a turn's 2nd..nth tool calls bubbles of their own, ids
+            // `<turn id>-tool-<k>` (a Cursor bubble holds one call); read them back as the
+            // one turn they came from, so a re-read has the shape of the first.
+            if let Some(prev) = self.turns.last_mut()
+                && bubble.kind == BUBBLE_TYPE_ASSISTANT
+                && turn.id.starts_with(&format!("{}-tool-", prev.id))
+            {
+                prev.tool_uses.extend(turn.tool_uses);
+                prev.file_mutations.extend(turn.file_mutations);
+                continue;
+            }
             prev_turn_id = Some(turn.id.clone());
             self.turns.push(turn);
         }
