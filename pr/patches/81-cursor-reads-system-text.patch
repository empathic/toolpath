+    pub fn model_messages(&self) -> Vec<Value> {
+        self.data
+            .model_history_hashes()
+            .iter()
+            .filter_map(|h| self.agent_blobs.get(h))
+            .filter_map(|body| serde_json::from_str(body).ok())
+            .collect()
+    }
 }
 
