+                {"id": "claim:w", "status": "pinned", "evidence_kinds": [], "evidence": []},
+            ],
             "findings": [{"id": "finding:known_defect:y", "kind": "known_defect", "pieces": [], "concerns": []}],
         });
         let bad = check(&m);
-        assert_eq!(bad.len(), 3, "{bad:?}");
+        assert_eq!(bad.len(), 4, "{bad:?}");
     }
 }
