new file mode 100644
index 00000000..516920c4
--- /dev/null
+++ b/crates/toolpath-goldens/src/classify.rs
@@ -0,0 +1,110 @@
+//! Classify a round trip's lost and gained key paths against the target writer's declared
+//! contract (`fixtures/contract/<agent>.json`). Step 1 of `pr/78`, in report mode: it counts, it
+//! does not fail.
+//!
+//! A path is **declared** when an op of the target's contract covers it (the path itself or
+//! anything under it); every other path is **unexplained**. The classes `source-bookkeeping`,
+//! `minted` and `renamed` of the design are reserved for the next step: until their declarations
+//! exist those paths are counted as unexplained, so the table shows the whole job.
+
+use std::collections::BTreeSet;
+
+use crate::transform::{Contract, Op};
+
+/// Whether `path` is `declared` itself or lies under it (`a.b` covers `a.b.c` and `a.b[]`).
+pub fn covers(declared: &str, path: &str) -> bool {
+    path == declared
+        || path
+            .strip_prefix(declared)
+            .is_some_and(|rest| rest.starts_with('.') || rest.starts_with('['))
+}
+
+/// Counts for one round trip.
+#[derive(Debug, Default, PartialEq, Eq, Clone)]
+pub struct Classified {
+    pub lost_declared: usize,
+    pub lost_unexplained: usize,
+    pub gained_declared: usize,
+    pub gained_unexplained: usize,
+}
+
+/// The paths a contract says are lost, and the paths it says are gained.
+fn declared_sets(contract: &Contract) -> (Vec<&str>, Vec<&str>) {
+    let (mut lost, mut gained) = (Vec::new(), Vec::new());
+    for op in &contract.ops {
+        match op {
+            Op::Drop { path, .. } => lost.push(path.as_str()),
+            Op::Rename { from, to } | Op::Move { from, to } => {
+                lost.push(from.as_str());
+                gained.push(to.as_str());
+            }
+            Op::Synthesize { path, .. } => gained.push(path.as_str()),
+            Op::Keep { .. } | Op::Convert { .. } => {}
+        }
+    }
+    (lost, gained)
+}
+
+/// Classify `lost` and `gained` for a target whose contract is `contract`.
+pub fn classify(
+    contract: &Contract,
+    lost: &BTreeSet<String>,
+    gained: &BTreeSet<String>,
+) -> Classified {
+    let (dl, dg) = declared_sets(contract);
+    let count = |paths: &BTreeSet<String>, declared: &[&str]| {
+        let d = paths
+            .iter()
+            .filter(|p| declared.iter().any(|d| covers(d, p)))
+            .count();
+        (d, paths.len() - d)
+    };
+    let (lost_declared, lost_unexplained) = count(lost, &dl);
+    let (gained_declared, gained_unexplained) = count(gained, &dg);
+    Classified {
+        lost_declared,
+        lost_unexplained,
+        gained_declared,
+        gained_unexplained,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn contract() -> Contract {
+        serde_json::from_str(
+            r#"{"writer":"x","ops":[
+              {"op":"drop","path":"a.b","why":"w"},
+              {"op":"rename","from":"c","to":"d"},
+              {"op":"synthesize","path":"e","why":"w"}]}"#,
+        )
+        .unwrap()
+    }
+
+    #[test]
+    fn a_declared_path_covers_what_lies_under_it_and_nothing_beside_it() {
+        assert!(covers("a.b", "a.b"));
+        assert!(covers("a.b", "a.b.c"));
+        assert!(covers("a.b", "a.b[]"));
+        assert!(!covers("a.b", "a.bc"));
+        assert!(!covers("a.b", "a"));
+    }
+
+    #[test]
+    fn declared_and_unexplained_paths_are_counted_apart() {
+        let lost: BTreeSet<String> = ["a.b.x", "c", "z"].map(String::from).into();
+        let gained: BTreeSet<String> = ["d", "e", "q"].map(String::from).into();
+        let c = classify(&contract(), &lost, &gained);
+        assert_eq!(
+            c,
+            Classified {
+                lost_declared: 2,
+                lost_unexplained: 1,
+                gained_declared: 2,
+                gained_unexplained: 1
+            }
+        );
+    }
+}
