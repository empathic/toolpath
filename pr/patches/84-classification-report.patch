diff --git a/crates/toolpath-goldens/tests/classification.rs b/crates/toolpath-goldens/tests/classification.rs
new file mode 100644
index 00000000..c6b1a583
--- /dev/null
+++ b/crates/toolpath-goldens/tests/classification.rs
@@ -0,0 +1,131 @@
+//! The coverage map (pr/78 step 1): for every recording x target round trip, how many lost and
+//! gained key paths the TARGET writer's contract declares and how many nothing explains. Read
+//! from the committed `round_trip@<set>@<target>.snap` files; the table is committed as
+//! `docs/baseline/classification.md` and this test fails when it is stale.
+//! Regenerate with `UPDATE_CLASSIFICATION=1 cargo test -p toolpath-goldens --test classification`.
+//! Report mode: unexplained paths are counted, they do not fail the test (a later step does).
+
+use std::collections::{BTreeMap, BTreeSet};
+use std::path::PathBuf;
+
+use serde_json::Value;
+use toolpath_goldens::classify::{Classified, classify};
+use toolpath_goldens::transform::Contract;
+
+fn crate_dir() -> PathBuf {
+    PathBuf::from(env!("CARGO_MANIFEST_DIR"))
+}
+
+fn contract(target: &str) -> Contract {
+    let p = crate_dir().join(format!("fixtures/contract/{target}.json"));
+    let text = std::fs::read_to_string(&p).unwrap_or_else(|e| panic!("{}: {e}", p.display()));
+    serde_json::from_str(&text).unwrap_or_else(|e| panic!("{}: {e}", p.display()))
+}
+
+fn set(v: &Value) -> BTreeSet<String> {
+    v.as_array()
+        .into_iter()
+        .flatten()
+        .map(|p| p.as_str().expect("a key path").to_owned())
+        .collect()
+}
+
+/// `(recording set, target) -> classified`, plus the pairs whose round trip was unreadable.
+fn measure() -> (BTreeMap<(String, String), Classified>, Vec<String>) {
+    let mut out = BTreeMap::new();
+    let mut unreadable = Vec::new();
+    let mut contracts: BTreeMap<String, Contract> = BTreeMap::new();
+    for entry in std::fs::read_dir(crate_dir().join("snapshots")).expect("snapshots") {
+        let name = entry
+            .expect("entry")
+            .file_name()
+            .to_string_lossy()
+            .into_owned();
+        let Some(rest) = name
+            .strip_prefix("round_trip@")
+            .and_then(|r| r.strip_suffix(".snap"))
+        else {
+            continue;
+        };
+        let (set_name, target) = rest.split_once('@').expect("round_trip@<set>@<target>");
+        let text = std::fs::read_to_string(crate_dir().join("snapshots").join(&name)).unwrap();
+        let body = text.splitn(3, "---\n").nth(2).expect("snapshot body");
+        let v: Value = serde_json::from_str(body).unwrap_or_else(|e| panic!("{name}: {e}"));
+        if v["outcome"] != "compared" {
+            unreadable.push(format!("{set_name} -> {target}"));
+            continue;
+        }
+        let c = contracts
+            .entry(target.to_owned())
+            .or_insert_with(|| contract(target));
+        out.insert(
+            (set_name.to_owned(), target.to_owned()),
+            classify(c, &set(&v["lost"]), &set(&v["gained"])),
+        );
+    }
+    (out, unreadable)
+}
+
+fn render() -> String {
+    let (rows, unreadable) = measure();
+    let mut s = String::new();
+    s.push_str(
+        "# Classification of lost and gained key paths on the real round trips\n\n\
+         Generated by `tests/classification.rs` from the committed `round_trip@*` snapshots and \
+         `fixtures/contract/<target>.json`. Regenerate with `UPDATE_CLASSIFICATION=1 cargo test -p \
+         toolpath-goldens --test classification`.\n\n\
+         **Report mode (pr/78 step 1).** A path is *declared* when the target writer's contract \
+         covers it; everything else is *unexplained*. The design's other classes (source \
+         bookkeeping, minted, renamed) have no declarations yet, so those paths are counted as \
+         unexplained here: the table is the size of the job, not a list of defects.\n\n\
+         | recording | target | lost declared | lost unexplained | gained declared | gained unexplained |\n\
+         |---|---|---:|---:|---:|---:|\n",
+    );
+    let mut total = Classified::default();
+    for ((set, target), c) in &rows {
+        s.push_str(&format!(
+            "| {set} | {target} | {} | {} | {} | {} |\n",
+            c.lost_declared, c.lost_unexplained, c.gained_declared, c.gained_unexplained
+        ));
+        total.lost_declared += c.lost_declared;
+        total.lost_unexplained += c.lost_unexplained;
+        total.gained_declared += c.gained_declared;
+        total.gained_unexplained += c.gained_unexplained;
+    }
+    s.push_str(&format!(
+        "| **{} pairs** | | **{}** | **{}** | **{}** | **{}** |\n",
+        rows.len(),
+        total.lost_declared,
+        total.lost_unexplained,
+        total.gained_declared,
+        total.gained_unexplained
+    ));
+    if !unreadable.is_empty() {
+        s.push_str(&format!(
+            "\nRound trips the adapter could not read (not classified): {}\n",
+            unreadable.join(", ")
+        ));
+    }
+    s
+}
+
+#[test]
+fn the_committed_classification_table_is_current() {
+    let path = crate_dir().join("../../docs/baseline/classification.md");
+    let now = render();
+    if std::env::var_os("UPDATE_CLASSIFICATION").is_some() {
+        std::fs::write(&path, &now).expect("write the table");
+        return;
+    }
+    let committed = std::fs::read_to_string(&path).unwrap_or_default();
+    assert_eq!(
+        committed, now,
+        "docs/baseline/classification.md is stale; regenerate it with UPDATE_CLASSIFICATION=1"
+    );
+}
+
+#[test]
+fn every_recording_and_target_is_classified() {
+    let (rows, unreadable) = measure();
+    assert_eq!(rows.len() + unreadable.len(), 63, "one row per round trip");
+}
