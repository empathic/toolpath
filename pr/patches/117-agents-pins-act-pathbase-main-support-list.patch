+live_check = "not recorded"
+pinned = "none"
+format_doc = "docs/agents/formats/copilot-cli"
+listed_by = ["gh-aw"] # UNVERIFIED, from memory
+
+[[agent]]
+name = "claude"
+vendor = "Anthropic"
+crate = "toolpath-claude"
+reader = true
+writer = true
+resume = true
+replay = "pending"
+replay_why = "cassettes are stale (11 requests miss: /v1/messages?beta=true); needs a keyed re-record"
+live_check = "not recorded"
+pinned = "none"
+format_doc = "docs/agents/formats/claude-code"
+listed_by = ["gh-aw"] # UNVERIFIED, from memory
+
+[[agent]]
+name = "codex"
+vendor = "OpenAI"
+crate = "toolpath-codex"
+reader = true
+writer = true
+resume = true
+replay = "pending"
+replay_why = "TLS half proven (webmock serve_tls); the codex wiring in run.rs is not done and needs a pinned codex from agents.lock"
+live_check = "not recorded"
+pinned = "none"
+format_doc = "docs/agents/formats/codex.md"
+listed_by = ["gh-aw"] # UNVERIFIED, from memory
+
+[[agent]]
+name = "gemini"
+vendor = "Google"
+crate = "toolpath-gemini"
+reader = true
+writer = true
+resume = true
+replay = "pending"
+replay_why = "replay_gemini is registered but skips: no gemini CLI is pinned"
+live_check = "not recorded"
+pinned = "none"
+format_doc = "docs/agents/formats/gemini.md"
+listed_by = []
+
+[[agent]]
+name = "pi"
+vendor = "pi-coding-agent (community)" # UNVERIFIED vendor name
+crate = "toolpath-pi"
+reader = true
+writer = true
+resume = true
+replay = "pending"
+replay_why = "cassette is stale (miss on /backend-api/codex/responses); needs a keyed re-record"
+live_check = "not recorded"
+pinned = "none"
+format_doc = "docs/agents/formats/pi.md"
+listed_by = []
+
+[[agent]]
