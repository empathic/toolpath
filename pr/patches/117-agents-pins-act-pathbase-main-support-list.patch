+# The supported-agents list: the source of truth. `cargo xtask agents` renders SUPPORT.md from it
+# (just agents) and `cargo test -p xtask` fails when an entry disagrees with the repo (the crate,
+# the projector, the harness, the replay test, the format doc, agents.lock).
+# Update it in the same commit as any agent change.
+#
+# replay: "green" (a registered replay_<name> test passes against a pinned cassette), "pending",
+# or "none"; replay_why says why when it is not green.
+# pinned: a version present in agents.lock, or "none". live_check: free text; "not recorded"
+# means nobody has written down a live check for this agent yet.
+# listed_by: outside lists that name the agent as an engine (gh-aw ...). UNVERIFIED where marked.
+
+[[agent]]
+name = "copilot"
+vendor = "GitHub"
+crate = "toolpath-copilot"
+reader = true
+writer = true
+resume = true
+replay = "pending"
