+vendor = "opencode (sst)" # UNVERIFIED vendor name
+crate = "toolpath-opencode"
+reader = true
+writer = true
+resume = true
+replay = "green"
+replay_why = "loose keys; the cell runs `opencode session list` once to create its db"
+live_check = "not recorded"
+pinned = "none"
+format_doc = "docs/agents/formats/opencode.md"
+listed_by = []
+
+[[agent]]
+name = "cursor"
