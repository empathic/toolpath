+crate = "toolpath-cursor"
+reader = true
+writer = true
+resume = true # also the `cursor-agent` harness (resume target only)
+replay = "pending"
+replay_why = "no cassette yet: needs a recording first"
+live_check = "not recorded"
+pinned = "none"
+format_doc = "docs/agents/formats/cursor.md"
+listed_by = []
+
