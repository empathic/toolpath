index 00000000..8ff2a079
--- /dev/null
+++ b/crates/toolpath-goldens/fixtures/twice-around.json
@@ -0,0 +1,28 @@
+[
+  {"target":"copilot","kind":"changed","path":"graph.id","why":"Copilot's projection mints a session id on every export (pipeline.rs settle/canonical), and the derived graph id embeds it, so it differs each pass by design."},
+  {"target":"copilot","kind":"changed","path":"paths[].path.id","why":"Embeds the session id Copilot's projection mints on every export; differs each pass by design."},
+  {"target":"copilot","kind":"changed","path":"paths[].meta.title","why":"The title is 'Copilot session: <minted id>'; follows the per-export minted session id."},
+  {"target":"copilot","kind":"changed","path":"paths[].steps[].step.id","why":"Copilot event ids are minted from a per-export sequence (event_uuid), so pass 1 ids are replaced on pass 2; the structure and order are unchanged."},
+  {"target":"copilot","kind":"changed","path":"paths[].steps[].step.parents[]","why":"Parent references point at the re-minted step ids."},
+  {"target":"copilot","kind":"changed","path":"paths[].steps[].step.actor","why":"Actor ids are derived from the step's role/model as Copilot records it; the first read maps the source's actor, the second the Copilot-shaped one."},
+  {"target":"copilot","kind":"changed","path":"paths[].steps[].step.timestamp","why":"Steps that Copilot has no timestamp for take the neighbouring event's time on the second read."},
+  {"target":"copilot","kind":"changed","path":"paths[].path.head","why":"Head is a step id; follows the re-minted ids."},
+  {"target":"copilot","kind":"changed","path":"paths[].meta.actors.<actor>.name","why":"Actor display name is derived from the re-minted actor id."},
+  {"target":"copilot","kind":"changed","path":"paths[].steps[].change.<artifact>.structural.role","why":"The first read keeps the source role; Copilot has no developer/system role on read, so the second read reports the Copilot one.","defect":"copilot reader has no system.message case (types.rs:131): fix as pr/70."},
+  {"target":"copilot","kind":"changed","path":"paths[].steps[].change.<artifact>.structural.type","why":"A system.message the writer emits is read back as a generic event, then re-typed on the next pass.","defect":"copilot reader has no system.message case (types.rs:131): fix as pr/70."},
+  {"target":"copilot","kind":"lost","path":"paths[].steps[].change.<artifact>.structural.content","why":"Developer text carried by system.message is dropped when the reader turns it into an event; pass 2 drops it entirely.","defect":"copilot reader drops system.message (types.rs:131): fix as pr/70."},
+  {"target":"copilot","kind":"lost","path":"paths[].steps[].change.<artifact>.structural.entry_type","why":"Lost with the system.message steps that carried it.","defect":"copilot reader drops system.message (types.rs:131): fix as pr/70."},
+  {"target":"copilot","kind":"lost","path":"paths[].steps[].change.<artifact>.structural.event_source_id","why":"Lost with the system.message steps that carried it.","defect":"copilot reader drops system.message (types.rs:131): fix as pr/70."},
+  {"target":"copilot","kind":"lost","path":"paths[].meta.actors.<actor>.provider","why":"The provider was on the actor of the dropped system.message step.","defect":"copilot reader drops system.message (types.rs:131): fix as pr/70."},
+  {"target":"codex","kind":"changed","path":"paths[].steps[].change.<artifact>.structural.turn_id","why":"exec_command_end.turn_id is copied from the source id, then the reader renumbers turns to codex-turn-NNNN; settles after one pass (project.rs:679, provider.rs:328).","defect":"stabilise by writing codex-turn-NNNN ids at projection time."},
+  {"target":"codex","kind":"changed","path":"paths[].steps[].step.id","why":"The codex writer stamps a turn_context for a turn it writes nothing for, so ids shift to the next turn on the second read.","defect":"codex empty-turn turn_context (project.rs:160,169-199,483): fix as pr/69."},
+  {"target":"codex","kind":"changed","path":"paths[].steps[].step.parents[]","why":"Parent references follow the shifted step ids.","defect":"codex empty-turn turn_context: fix as pr/69."},
+  {"target":"codex","kind":"changed","path":"paths[].steps[].step.timestamp","why":"The shifted turn_context takes the next turn's timestamp.","defect":"codex empty-turn turn_context: fix as pr/69."},
+  {"target":"codex","kind":"changed","path":"paths[].steps[].step.actor","why":"The shifted turn_context carries the next turn's actor.","defect":"codex empty-turn turn_context: fix as pr/69."},
+  {"target":"codex","kind":"changed","path":"paths[].steps[].change.<artifact>.structural.event_source_id","why":"Follows the shifted turn_context step.","defect":"codex empty-turn turn_context: fix as pr/69."},
+  {"target":"codex","kind":"changed","path":"paths[].steps[].change.<artifact>.structural.cwd","why":"Settings on the shifted turn_context move with it.","defect":"codex empty-turn turn_context: fix as pr/69."},
+  {"target":"codex","kind":"changed","path":"paths[].steps[].change.<artifact>.structural.entry_type","why":"Follows the shifted turn_context step.","defect":"codex empty-turn turn_context: fix as pr/69."},
+  {"target":"codex","kind":"changed","path":"paths[].steps[].change.<artifact>.structural.model","why":"Settings on the shifted turn_context move with it.","defect":"codex empty-turn turn_context: fix as pr/69."},
+  {"target":"codex","kind":"changed","path":"paths[].steps[].change.<artifact>.structural.model_provider","why":"Settings on the shifted turn_context move with it.","defect":"codex empty-turn turn_context: fix as pr/69."},
+  {"target":"codex","kind":"changed","path":"paths[].steps[].change.<artifact>.structural.type","why":"Follows the shifted turn_context step.","defect":"codex empty-turn turn_context: fix as pr/69."}
+]
