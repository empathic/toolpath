 ok "path share (not logged in) uploads anonymously and prints the graph URL"
 
 # --- path resume <pathbase URL> --harness codex ------------------------------
-SITE_URL="https://pathbase.dev/alex/pathstash/path-pr-42"
-if out="$(p resume "$SITE_URL" --harness codex --no-cache 2>&1)"; then
-    fail "the site's resume URL resolved; it was expected to be refused before any network call"
-fi
-case "$out" in *"uuid"*|*"UUID"*) ;; *) fail "site resume URL failed for an unexpected reason: $out" ;; esac
-cannot "the site's '$SITE_URL' cannot resolve: a Pathbase graph is addressed by UUID, and the CLI refuses a slug ('path-pr-42') before any request"
-
 # A codex stub stands in for the harness: it records argv and the rollout
 # path the projection wrote, so the test can check codex would find it.
 mkdir -p "$STUBS/codex-bin"
@@ -317,6 +310,19 @@ head -1 "$new_rollout" | python3 -c 'import json,sys,os; m=json.loads(sys.stdin.
