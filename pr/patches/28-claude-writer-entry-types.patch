-/// `key<TAB>count` lines (illegal types): fixed when only counts fell or keys vanished.
-fn judge_counts(_: &SetRun, _: &[u8], pinned: &str, fresh: &str) -> Verdict {
-    let parse = |t: &str| -> BTreeMap<String, u64> {
-        t.lines()
-            .filter_map(|l| l.split_once('\t'))
-            .map(|(k, n)| (k.to_string(), n.trim().parse().unwrap_or(0)))
-            .collect()
-    };
-    let (was, is) = (parse(pinned), parse(fresh));
-    let worse: Vec<String> = is
-        .iter()
-        .filter(|(k, n)| was.get(*k).is_none_or(|w| *n > w))
-        .map(|(k, n)| format!("{k} {} -> {n}", was.get(k).copied().unwrap_or(0)))
-        .collect();
-    if worse.is_empty() {
-        let gone: Vec<&str> = was
-            .keys()
-            .filter(|k| !is.contains_key(*k))
-            .map(String::as_str)
-            .collect();
-        Verdict::Fixed(format!("no longer written: {}", gone.join(", ")))
-    } else {
-        Verdict::Worse(format!("more or new: {}", worse.join(", ")))
-    }
-}
