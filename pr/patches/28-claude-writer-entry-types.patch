-/// `source<TAB>written` rename lines: a pinned rename is fixed only when the source path is written
-/// again under its own name; if neither name is written the field is lost outright (worse).
-fn judge_renames(_: &SetRun, out: &[u8], pinned: &str, fresh: &str) -> Verdict {
-    let written = raw_paths(&String::from_utf8_lossy(out));
-    let (was, is): (BTreeSet<&str>, BTreeSet<&str>) =
-        (pinned.lines().collect(), fresh.lines().collect());
-    let mut worse: Vec<String> = is
-        .difference(&was)
-        .map(|l| format!("new rename {}", l.replace('\t', " -> ")))
-        .collect();
-    let mut fixed = Vec::new();
-    for l in was.difference(&is) {
-        let src = l.split('\t').next().unwrap_or(l);
-        if written.contains_key(src) {
-            fixed.push(format!("{src} written again"));
-        } else {
-            worse.push(format!("{src} is no longer written under either name"));
-        }
-    }
-    if worse.is_empty() {
-        Verdict::Fixed(fixed.join(", "))
-    } else {
-        Verdict::Worse(worse.join(", "))
