+{"metabox":"1","type":"annotation","subject":"RFC.md","issuer":"mailto:1240090+bdelanghe@users.noreply.github.com","issuer_type":"ai","created_at":"2026-10-19T20:27:50.251606Z","id":"5f1ea358c5f2e9229930eccfcb3ca23ddbd42f59f24711ece2daf578873a3c70","body":{"detail":"A commit signed with a throwaway SSH key (vcs@mapping row 4) imports with no meta.signatures. Not implemented on purpose: a git signature covers the commit object, while an RFC step signature covers JCS({step, change}); copying the armored sig into meta.signatures as scope author would make RFC verification fail. Options: carry it as a VCS attestation (e.g. meta.source.extra.gpgsig) or define a 'vcs-commit' signature scope in the RFC.","kind":"concern","span":{"start":{"line":931},"end":{"line":931},"content_hash":"dfbc322d5c7653e059617d34fd76fbe92b62d4bcc183ae819b236a3a4651b6fd"},"summary":"GPG/SSH signature → meta.signatures does not hold: the git import never reads gpgsig","tags":["rfc-vcs","goldens","session:claude-code:729d6bb8-59f0-4ddf-892e-603372433260"]}}
