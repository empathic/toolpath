index e024922..1840e00 100644
--- a/crates/path-cli/src/cmd_validate.rs
+++ b/crates/path-cli/src/cmd_validate.rs
@@ -1,6 +1,8 @@
 use anyhow::{Context, Result};
 use std::path::PathBuf;
-use toolpath::v1::Graph;
+use toolpath::v1::{
