From 843c01d2d2b5c8cc7e0e04dd7aad347d053eda4e Mon Sep 17 00:00:00 2001
From: Robert DeLanghe <1240090+bdelanghe@users.noreply.github.com>
Date: Thu, 15 Oct 2026 19:40:50 -0400
Subject: [PATCH] fix(quality-gates): the secrets gate scans . from the repo
 root so the .gitleaks.toml path allowlist applies
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

gitleaks reports file paths the way the scan target was spelled. Handed the absolute repo root,
every path came back absolute, the repo-relative allowlist anchors (^target/, lockfiles, site/)
matched nothing, and a checkout that had been built reported every build script's -Users-… output
as a leak: 1888 findings over 286 MB on a worktree with target/, against 0 over 24 MB when the
same tree is scanned as . from the root. The first run of this gate was on a fresh worktree with
no target/, which is why it passed. Verified: PASS with target/ present, shellcheck gate PASS.
---
 scripts/quality_gates.sh | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/scripts/quality_gates.sh b/scripts/quality_gates.sh
index cc56d626..7e47aa41 100755
--- a/scripts/quality_gates.sh
+++ b/scripts/quality_gates.sh
@@ -119,7 +119,12 @@ gate_secrets() {
         echo "gitleaks not on PATH; skipped (crates/toolpath-webmock/tests/no_secrets.rs covers the fixture surfaces under the test gate)"
         return 0
     fi
-    gitleaks dir "${_root}" --config "${_root}/.gitleaks.toml" --no-banner --redact 2>&1
+    # From the repo root, scanning `.`: gitleaks reports paths the way the target was spelled,
+    # and the path allowlist in .gitleaks.toml is anchored repo-relative (`^target/`). Handed
+    # the absolute root it reports absolute paths, nothing in the allowlist matches, and a
+    # checkout that has been built reports every build script's `-Users-…` output as a leak
+    # (1888 findings over 286 MB on a worktree with target/; 0 over 24 MB from `.`).
+    (cd "${_root}" && gitleaks dir . --config .gitleaks.toml --no-banner --redact 2>&1)
 }
 
 # ── Runner ────────────────────────────────────────────────────────────────────
-- 
