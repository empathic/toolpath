+
+/// `path d baseline check` with no set: run [`CHECK_COMMANDS`] from the repository root, so the
+/// command and `cargo test` are one implementation. The environment passes through
+/// (`TOOLPATH_GOLDENS_QUALIFIER`, `CARGO_TARGET_DIR`).
+fn check_through_cargo_test(root: &Path) -> Result<()> {
+    let cargo = std::env::var_os("CARGO").unwrap_or_else(|| "cargo".into());
+    for args in CHECK_COMMANDS {
+        eprintln!("baseline check: cargo {}", args.join(" "));
+        let status = Command::new(&cargo)
+            .args(*args)
+            .current_dir(root)
+            .status()
+            .context("run cargo (the baseline check is `cargo test`)")?;
+        if !status.success() {
+            std::process::exit(status.code().unwrap_or(1));
+        }
+    }
+    Ok(())
+}
