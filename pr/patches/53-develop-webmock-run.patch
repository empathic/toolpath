+/// The tests that are the baseline check, in the order `path d baseline check` runs them: the
+/// snapshot crate (every recording's stages, writers, formats, the qualifier review), then the
+/// manifest goldens (the same `Goldens::check` this tool runs in-process).
+pub const CHECK_COMMANDS: &[&[&str]] = &[
+    &["test", "-q", "-p", "toolpath-goldens"],
+    &[
+        "test",
+        "-q",
+        "-p",
+        "path-cli",
