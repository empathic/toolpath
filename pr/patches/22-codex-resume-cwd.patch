diff --git a/crates/path-cli/src/projection/codex.rs b/crates/path-cli/src/projection/codex.rs
index 764e193d..1cbf90ff 100644
--- a/crates/path-cli/src/projection/codex.rs
+++ b/crates/path-cli/src/projection/codex.rs
@@ -242,4 +242,90 @@ mod tests {
         let codex_sessions = fake_home.join(".codex/sessions");
